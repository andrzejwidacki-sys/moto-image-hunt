{"duration": 333.7813125, "segments": [{"start": 0.02, "end": 2.52, "text": "Wypad na dwa dni do Gokarny.", "words": [[0.02, 0.88, " Wypad"], [0.88, 1.06, " na"], [1.06, 1.28, " dwa"], [1.28, 1.46, " dni"], [1.46, 1.64, " do"], [1.64, 2.52, " Gokarny."]]}, {"start": 3.24, "end": 6.34, "text": "Droga w jedną stronę, dziewięć i pół godziny.", "words": [[3.24, 3.54, " Droga"], [3.54, 3.74, " w"], [3.74, 3.98, " jedną"], [3.98, 4.8, " stronę,"], [4.94, 5.3, " dziewięć"], [5.3, 5.46, " i"], [5.46, 5.6, " pół"], [5.6, 6.34, " godziny."]]}, {"start": 6.96, "end": 8.92, "text": "W obie strony, dziewiętnaście.", "words": [[6.96, 7.1, " W"], [7.1, 7.34, " obie"], [7.34, 7.78, " strony,"], [8.02, 8.92, " dziewiętnaście."]]}, {"start": 9.58, "end": 10.32, "text": "A Majsuru?", "words": [[9.58, 9.74, " A"], [9.74, 10.32, " Majsuru?"]]}, {"start": 11.3, "end": 13.98, "text": "Dwie i pół godziny w jedną stronę.", "words": [[11.3, 11.56, " Dwie"], [11.56, 11.74, " i"], [11.74, 11.9, " pół"], [11.9, 12.38, " godziny"], [12.38, 12.54, " w"], [12.54, 12.98, " jedną"], [12.98, 13.98, " stronę."]]}, {"start": 14.16, "end": 16.92, "text": "Ten sam film obiecuje oba wypady na dwa dni.", "words": [[14.16, 14.38, " Ten"], [14.38, 14.72, " sam"], [14.72, 14.96, " film"], [14.96, 15.56, " obiecuje"], [15.56, 15.88, " oba"], [15.88, 16.18, " wypady"], [16.18, 16.44, " na"], [16.44, 16.58, " dwa"], [16.58, 16.92, " dni."]]}, {"start": 17.74, "end": 20.74, "text": "Sześć miejsc z jednego filmu o wypadach z Bengalu.", "words": [[17.74, 18.12, " Sześć"], [18.12, 18.4, " miejsc"], [18.4, 18.64, " z"], [18.64, 19.06, " jednego"], [19.06, 19.5, " filmu"], [19.5, 19.66, " o"], [19.66, 20.08, " wypadach"], [20.08, 20.28, " z"], [20.28, 20.74, " Bengalu."]]}, {"start": 21.68, "end": 24.2, "text": "Autor podaje na ekranie kilometry.", "words": [[21.68, 22.16, " Autor"], [22.16, 22.6, " podaje"], [22.6, 22.8, " na"], [22.8, 23.32, " ekranie"], [23.32, 24.2, " kilometry."]]}, {"start": 24.84, "end": 27.54, "text": "Ja liczę godziny w aucie, w obie strony.", "words": [[24.84, 24.98, " Ja"], [24.98, 25.28, " liczę"], [25.28, 25.7, " godziny"], [25.7, 25.96, " w"], [25.96, 26.46, " aucie,"], [26.66, 26.82, " w"], [26.82, 27.14, " obie"], [27.14, 27.54, " strony."]]}, {"start": 27.54, "end": 30.66, "text": "Do jedenastu godzin mieści się.", "words": [[27.54, 28.56, " Do"], [28.56, 29.18, " jedenastu"], [29.18, 29.72, " godzin"], [29.72, 30.18, " mieści"], [30.18, 30.66, " się."]]}, {"start": 31.38, "end": 33.34, "text": "Do piętnastu na styk.", "words": [[31.38, 31.46, " Do"], [31.46, 32.28, " piętnastu"], [32.28, 32.5, " na"], [32.5, 33.34, " styk."]]}, {"start": 33.8, "end": 35.54, "text": "Więcej za daleko.", "words": [[33.8, 34.44, " Więcej"], [34.44, 34.7, " za"], [34.7, 35.54, " daleko."]]}, {"start": 36.04, "end": 38.04, "text": "Ile z sześciu przejdzie ten test?", "words": [[36.04, 36.26, " Ile"], [36.26, 36.46, " z"], [36.46, 36.92, " sześciu"], [36.92, 37.26, " przejdzie"], [37.26, 37.58, " ten"], [37.58, 38.04, " test?"]]}, {"start": 38.98, "end": 40.5, "text": "Zaczynamy od Pondicherry.", "words": [[38.98, 39.54, " Zaczynamy"], [39.54, 39.74, " od"], [39.74, 40.5, " Pondicherry."]]}, {"start": 41.22, "end": 44.84, "text": "Pondicherry na ekranie 322 kilometry.", "words": [[41.22, 42.14, " Pondicherry"], [42.14, 42.6, " na"], [42.6, 43.18, " ekranie"], [43.18, 44.18, " 322"], [44.18, 44.84, " kilometry."]]}, {"start": 45.82, "end": 47.04, "text": "A ile to godzin?", "words": [[45.82, 45.9, " A"], [45.9, 46.0, " ile"], [46.0, 46.4, " to"], [46.4, 47.04, " godzin?"]]}, {"start": 49.18, "end": 52.6, "text": "Tak wygląda Promenade Biecz, czarne głazy i fale.", "words": [[49.18, 49.5, " Tak"], [49.5, 50.02, " wygląda"], [50.02, 50.64, " Promenade"], [50.64, 51.06, " Biecz,"], [51.34, 51.64, " czarne"], [51.64, 52.0, " głazy"], [52.0, 52.34, " i"], [52.34, 52.6, " fale."]]}, {"start": 53.42, "end": 56.1, "text": "Łe w filmie był piasek i słomiane parasole.", "words": [[53.42, 53.66, " Łe"], [53.66, 53.78, " w"], [53.78, 54.08, " filmie"], [54.08, 54.3, " był"], [54.3, 54.84, " piasek"], [54.84, 54.98, " i"], [54.98, 55.44, " słomiane"], [55.44, 56.1, " parasole."]]}, {"start": 56.1, "end": 58.62, "text": "A tu Stare Molo.", "words": [[56.1, 57.06, " A"], [57.06, 57.34, " tu"], [57.34, 57.66, " Stare"], [57.66, 58.62, " Molo."]]}, {"start": 58.9, "end": 61.22, "text": "Ludzie kąpią się w morzu mimo fal.", "words": [[58.9, 59.18, " Ludzie"], [59.18, 59.68, " kąpią"], [59.68, 59.92, " się"], [59.92, 60.12, " w"], [60.12, 60.4, " morzu"], [60.4, 60.76, " mimo"], [60.76, 61.22, " fal."]]}, {"start": 61.98, "end": 63.48, "text": "Dzielnica francuska.", "words": [[61.98, 62.46, " Dzielnica"], [62.46, 63.48, " francuska."]]}, {"start": 63.68, "end": 65.3, "text": "Dom z kolumnami i palmy.", "words": [[63.68, 63.86, " Dom"], [63.86, 64.06, " z"], [64.06, 64.6, " kolumnami"], [64.6, 64.84, " i"], [64.84, 65.3, " palmy."]]}, {"start": 66.08, "end": 66.96, "text": "Z Bengaluru.", "words": [[66.08, 66.28, " Z"], [66.28, 66.96, " Bengaluru."]]}, {"start": 67.24, "end": 70.22, "text": "Około trzystu kilometrów i siedem godzin.", "words": [[67.24, 67.7, " Około"], [67.7, 68.18, " trzystu"], [68.18, 68.82, " kilometrów"], [68.82, 69.04, " i"], [69.04, 69.32, " siedem"], [69.32, 70.22, " godzin."]]}, {"start": 70.48, "end": 71.5, "text": "W obie strony.", "words": [[70.48, 70.7, " W"], [70.7, 70.98, " obie"], [70.98, 71.5, " strony."]]}, {"start": 71.74, "end": 73.98, "text": "Czternaście godzin w aucie.", "words": [[71.74, 72.36, " Czternaście"], [72.36, 72.76, " godzin"], [72.76, 73.06, " w"], [73.06, 73.98, " aucie."]]}, {"start": 74.36, "end": 75.82, "text": "Werdykt na styk.", "words": [[74.36, 74.94, " Werdykt"], [74.94, 75.22, " na"], [75.22, 75.82, " styk."]]}, {"start": 76.44, "end": 78.6, "text": "Moim zdaniem to wypad na trzy dni.", "words": [[76.44, 76.74, " Moim"], [76.74, 77.14, " zdaniem"], [77.14, 77.38, " to"], [77.38, 77.72, " wypad"], [77.72, 78.0, " na"], [78.0, 78.16, " trzy"], [78.16, 78.6, " dni."]]}, {"start": 80.1, "end": 82.86, "text": "Kurk, 250 kilometrów.", "words": [[80.1, 80.9, " Kurk,"], [80.9, 81.66, " 250"], [81.66, 82.86, " kilometrów."]]}, {"start": 82.86, "end": 84.92, "text": "Autor mówi tylko.", "words": [[82.86, 83.88, " Autor"], [83.88, 84.26, " mówi"], [84.26, 84.92, " tylko."]]}, {"start": 87.57, "end": 90.25, "text": "To widok z Rajasthit w Pondicherry.", "words": [[87.57, 87.73, " To"], [87.73, 88.07, " widok"], [88.07, 88.29, " z"], [88.29, 88.83, " Rajasthit"], [88.83, 89.07, " w"], [89.07, 90.25, " Pondicherry."]]}, {"start": 90.49, "end": 93.13, "text": "Łe w filmie na wzgórzu była tylko mgła.", "words": [[90.49, 90.71, " Łe"], [90.71, 90.77, " w"], [90.77, 91.11, " filmie"], [91.11, 91.25, " na"], [91.25, 91.67, " wzgórzu"], [91.67, 91.95, " była"], [91.95, 92.35, " tylko"], [92.35, 93.13, " mgła."]]}, {"start": 93.59, "end": 96.85, "text": "Tu też chmury wiszą nisko, ale widać dolinę.", "words": [[93.59, 93.71, " Tu"], [93.71, 93.95, " też"], [93.95, 94.29, " chmury"], [94.29, 94.65, " wiszą"], [94.65, 95.19, " nisko,"], [95.49, 95.59, " ale"], [95.59, 95.93, " widać"], [95.93, 96.85, " dolinę."]]}, {"start": 97.35, "end": 98.51, "text": "Wodospad Abbi.", "words": [[97.35, 97.97, " Wodospad"], [97.97, 98.51, " Abbi."]]}, {"start": 98.69, "end": 101.33, "text": "Osiem kilometrów od Pondicherry.", "words": [[98.69, 99.07, " Osiem"], [99.07, 99.73, " kilometrów"], [99.73, 99.91, " od"], [99.91, 101.33, " Pondicherry."]]}, {"start": 101.61, "end": 104.21, "text": "Woda spada kaskadami po skałach.", "words": [[101.61, 101.79, " Woda"], [101.79, 102.19, " spada"], [102.19, 102.81, " kaskadami"], [102.81, 103.03, " po"], [103.03, 104.21, " skałach."]]}, {"start": 104.53, "end": 107.39, "text": "Dachy Pondicherry widziane z fortu.", "words": [[104.53, 104.87, " Dachy"], [104.87, 105.61, " Pondicherry"], [105.61, 106.13, " widziane"], [106.13, 106.33, " z"], [106.33, 107.39, " fortu."]]}, {"start": 107.67, "end": 108.73, "text": "Z Bengaluru.", "words": [[107.67, 107.89, " Z"], [107.89, 108.73, " Bengaluru."]]}, {"start": 109.61, "end": 112.55, "text": "264 kilometry i 5 godzin 10 minut.", "words": [[109.61, 110.33, " 264"], [110.33, 110.89, " kilometry"], [110.89, 111.03, " i"], [111.03, 111.31, " 5"], [111.31, 111.63, " godzin"], [111.63, 112.05, " 10"], [112.05, 112.55, " minut."]]}, {"start": 112.55, "end": 114.11, "text": "Obie strony.", "words": [[112.55, 113.61, " Obie"], [113.61, 114.11, " strony."]]}, {"start": 114.43, "end": 116.45, "text": "Ponad 10 godzin.", "words": [[114.43, 114.89, " Ponad"], [114.89, 115.29, " 10"], [115.29, 116.45, " godzin."]]}, {"start": 116.75, "end": 118.37, "text": "Werdykt mieści się.", "words": [[116.75, 117.29, " Werdykt"], [117.29, 117.73, " mieści"], [117.73, 118.37, " się."]]}, {"start": 118.95, "end": 122.81, "text": "Moim zdaniem to pierwsze miejsce, gdzie dwa dni mają sens.", "words": [[118.95, 119.23, " Moim"], [119.23, 119.63, " zdaniem"], [119.63, 119.85, " to"], [119.85, 120.25, " pierwsze"], [120.25, 120.77, " miejsce,"], [121.17, 121.39, " gdzie"], [121.39, 121.65, " dwa"], [121.65, 121.85, " dni"], [121.85, 122.19, " mają"], [122.19, 122.81, " sens."]]}, {"start": 124.47, "end": 127.87, "text": "Gokarna na kranie 500 kilometrów.", "words": [[124.47, 125.17, " Gokarna"], [125.17, 125.63, " na"], [125.63, 126.25, " kranie"], [126.25, 126.57, " 500"], [126.57, 127.87, " kilometrów."]]}, {"start": 128.29, "end": 130.61, "text": "Zgadnij ile to godzin.", "words": [[128.29, 128.97, " Zgadnij"], [128.97, 129.11, " ile"], [129.11, 129.41, " to"], [129.41, 130.61, " godzin."]]}, {"start": 132.27, "end": 133.55, "text": "To plaża Kudle.", "words": [[132.27, 132.61, " To"], [132.61, 132.97, " plaża"], [132.97, 133.55, " Kudle."]]}, {"start": 133.77, "end": 135.89, "text": "Zatoka i sucha trawa na zboczu.", "words": [[133.77, 134.23, " Zatoka"], [134.23, 134.45, " i"], [134.45, 134.83, " sucha"], [134.83, 135.05, " trawa"], [135.05, 135.23, " na"], [135.23, 135.89, " zboczu."]]}, {"start": 136.53, "end": 140.01, "text": "Autor obiecuje czystą, spokojne plażę.", "words": [[136.53, 136.89, " Autor"], [136.89, 137.43, " obiecuje"], [137.43, 138.19, " czystą,"], [138.39, 138.93, " spokojne"], [138.93, 140.01, " plażę."]]}, {"start": 140.01, "end": 142.31, "text": "Plaża przy świątyni w pochmurny dzień.", "words": [[140.01, 140.51, " Plaża"], [140.51, 140.69, " przy"], [140.69, 141.23, " świątyni"], [141.23, 141.41, " w"], [141.41, 142.01, " pochmurny"], [142.01, 142.31, " dzień."]]}, {"start": 143.19, "end": 145.07, "text": "Motocykle zamiast ciszy.", "words": [[143.19, 143.75, " Motocykle"], [143.75, 144.27, " zamiast"], [144.27, 145.07, " ciszy."]]}, {"start": 145.61, "end": 147.39, "text": "I zachód słońca nad morzem.", "words": [[145.61, 145.81, " I"], [145.81, 146.07, " zachód"], [146.07, 146.57, " słońca"], [146.57, 146.85, " nad"], [146.85, 147.39, " morzem."]]}, {"start": 148.13, "end": 149.15, "text": "Z Bengaluru.", "words": [[148.13, 148.31, " Z"], [148.31, 149.15, " Bengaluru."]]}, {"start": 149.31, "end": 152.47, "text": "Około 490 kilometrów.", "words": [[149.31, 149.81, " Około"], [149.81, 150.95, " 490"], [150.95, 152.47, " kilometrów."]]}, {"start": 152.89, "end": 155.01, "text": "9,5 godziny w jedną stronę.", "words": [[152.89, 153.29, " 9"], [153.29, 153.61, ",5"], [153.61, 154.07, " godziny"], [154.07, 154.23, " w"], [154.23, 154.51, " jedną"], [154.51, 155.01, " stronę."]]}, {"start": 155.93, "end": 157.43, "text": "19 w obie strony.", "words": [[155.93, 156.51, " 19"], [156.51, 156.69, " w"], [156.69, 157.05, " obie"], [157.05, 157.43, " strony."]]}, {"start": 158.37, "end": 161.05, "text": "Z dwóch dni zostaje 29 godzin.", "words": [[158.37, 158.57, " Z"], [158.57, 158.81, " dwóch"], [158.81, 159.01, " dni"], [159.01, 159.51, " zostaje"], [159.51, 160.29, " 29"], [160.29, 161.05, " godzin."]]}, {"start": 161.71, "end": 163.69, "text": "Werdykt za daleko.", "words": [[161.71, 162.29, " Werdykt"], [162.29, 162.63, " za"], [162.63, 163.69, " daleko."]]}, {"start": 163.97, "end": 166.65, "text": "Moim zdaniem Gokarna to wypad na 4 dni.", "words": [[163.97, 164.27, " Moim"], [164.27, 164.71, " zdaniem"], [164.71, 165.21, " Gokarna"], [165.21, 165.41, " to"], [165.41, 165.77, " wypad"], [165.77, 165.99, " na"], [165.99, 166.31, " 4"], [166.31, 166.65, " dni."]]}, {"start": 168.25, "end": 170.65, "text": "Uti 260 kilometrów.", "words": [[168.25, 169.05, " Uti"], [169.05, 169.85, " 260"], [169.85, 170.65, " kilometrów."]]}, {"start": 171.63, "end": 172.81, "text": "Herbata i góry.", "words": [[171.63, 172.17, " Herbata"], [172.17, 172.47, " i"], [172.47, 172.81, " góry."]]}, {"start": 175.27, "end": 177.09, "text": "Tak wygląda Uti z bliska.", "words": [[175.27, 175.49, " Tak"], [175.49, 176.03, " wygląda"], [176.03, 176.37, " Uti"], [176.37, 176.61, " z"], [176.61, 177.09, " bliska."]]}, {"start": 177.39, "end": 178.93, "text": "Domy na zboczu i pylony.", "words": [[177.39, 177.65, " Domy"], [177.65, 177.89, " na"], [177.89, 178.29, " zboczu"], [178.29, 178.47, " i"], [178.47, 178.93, " pylony."]]}, {"start": 179.61, "end": 182.61, "text": "W kadrze filmu była tylko herbata i góry.", "words": [[179.61, 179.81, " W"], [179.81, 180.09, " kadrze"], [180.09, 180.51, " filmu"], [180.51, 180.73, " była"], [180.73, 181.15, " tylko"], [181.15, 181.75, " herbata"], [181.75, 181.99, " i"], [181.99, 182.61, " góry."]]}, {"start": 183.07, "end": 184.93, "text": "A to przystań łodzi nad jeziorem.", "words": [[183.07, 183.21, " A"], [183.21, 183.39, " to"], [183.39, 183.87, " przystań"], [183.87, 184.15, " łodzi"], [184.15, 184.37, " nad"], [184.37, 184.93, " jeziorem."]]}, {"start": 185.73, "end": 190.01, "text": "Autor sam ostrzega, że miasto może wydać się zbyt komercyjne.", "words": [[185.73, 186.17, " Autor"], [186.17, 186.41, " sam"], [186.41, 187.09, " ostrzega,"], [187.51, 187.59, " że"], [187.59, 187.97, " miasto"], [187.97, 188.23, " może"], [188.23, 188.63, " wydać"], [188.63, 188.85, " się"], [188.85, 189.25, " zbyt"], [189.25, 190.01, " komercyjne."]]}, {"start": 190.83, "end": 194.39, "text": "Kolejka górska Nilgilii należy do światowego dziedzictwa Unesco.", "words": [[190.83, 191.21, " Kolejka"], [191.21, 191.63, " górska"], [191.63, 192.19, " Nilgilii"], [192.19, 192.41, " należy"], [192.41, 192.69, " do"], [192.69, 193.19, " światowego"], [193.19, 193.77, " dziedzictwa"], [193.77, 194.39, " Unesco."]]}, {"start": 194.39, "end": 199.79, "text": "Uti leży na wysokości 2240 metrów.", "words": [[194.39, 195.49, " Uti"], [195.49, 195.79, " leży"], [195.79, 195.99, " na"], [195.99, 196.69, " wysokości"], [196.69, 198.51, " 2240"], [198.51, 199.79, " metrów."]]}, {"start": 200.07, "end": 200.97, "text": "Z Bengaluru.", "words": [[200.07, 200.29, " Z"], [200.29, 200.97, " Bengaluru."]]}, {"start": 201.25, "end": 205.61, "text": "Około 270 kilometrów i 6,5 godziny.", "words": [[201.25, 201.79, " Około"], [201.79, 202.63, " 270"], [202.63, 203.77, " kilometrów"], [203.77, 203.99, " i"], [203.99, 204.31, " 6"], [204.31, 204.61, ",5"], [204.61, 205.61, " godziny."]]}, {"start": 205.91, "end": 206.89, "text": "W obie strony.", "words": [[205.91, 206.09, " W"], [206.09, 206.33, " obie"], [206.33, 206.89, " strony."]]}, {"start": 207.07, "end": 208.39, "text": "13 godzin.", "words": [[207.07, 207.49, " 13"], [207.49, 208.39, " godzin."]]}, {"start": 208.97, "end": 210.73, "text": "Werdykt na styk.", "words": [[208.97, 209.51, " Werdykt"], [209.51, 209.81, " na"], [209.81, 210.73, " styk."]]}, {"start": 211.01, "end": 213.37, "text": "Moim zdaniem warto dołożyć trzeci dzień.", "words": [[211.01, 211.37, " Moim"], [211.37, 211.75, " zdaniem"], [211.75, 212.13, " warto"], [212.13, 212.61, " dołożyć"], [212.61, 213.07, " trzeci"], [213.07, 213.37, " dzień."]]}, {"start": 215.11, "end": 216.01, "text": "Cip Magalu.", "words": [[215.11, 215.33, " Cip"], [215.33, 216.01, " Magalu."]]}, {"start": 216.29, "end": 218.27, "text": "250 kilometrów.", "words": [[216.29, 217.19, " 250"], [217.19, 218.27, " kilometrów."]]}, {"start": 218.83, "end": 220.27, "text": "Kraina Kawy.", "words": [[218.83, 219.19, " Kraina"], [219.19, 220.27, " Kawy."]]}, {"start": 221.67, "end": 222.81, "text": "Mulejana Gili.", "words": [[221.67, 222.43, " Mulejana"], [222.43, 222.81, " Gili."]]}, {"start": 222.99, "end": 224.71, "text": "Najwyższy szczyt Karnataki.", "words": [[222.99, 223.51, " Najwyższy"], [223.51, 223.87, " szczyt"], [223.87, 224.71, " Karnataki."]]}, {"start": 226.55, "end": 228.07, "text": "1925 metrów.", "words": [[226.55, 227.31, " 1925"], [227.31, 228.07, " metrów."]]}, {"start": 228.19, "end": 229.25, "text": "Widok ze szczytu.", "words": [[228.19, 228.47, " Widok"], [228.47, 228.67, " ze"], [228.67, 229.25, " szczytu."]]}, {"start": 229.45, "end": 230.83, "text": "Równina w mgiełce.", "words": [[229.45, 229.83, " Równina"], [229.83, 229.97, " w"], [229.97, 230.83, " mgiełce."]]}, {"start": 231.51, "end": 234.91, "text": "Autor porównał krajobrazy do tapety z Windowsa.", "words": [[231.51, 231.79, " Autor"], [231.79, 232.37, " porównał"], [232.37, 232.99, " krajobrazy"], [232.99, 233.23, " do"], [233.23, 233.59, " tapety"], [233.59, 233.79, " z"], [233.79, 234.91, " Windowsa."]]}, {"start": 235.21, "end": 237.83, "text": "A tak wygląda Mła wśród wysoki drzew.", "words": [[235.21, 235.39, " A"], [235.39, 235.57, " tak"], [235.57, 236.11, " wygląda"], [236.11, 236.41, " Mła"], [236.41, 236.79, " wśród"], [236.79, 237.31, " wysoki"], [237.31, 237.83, " drzew."]]}, {"start": 238.57, "end": 239.59, "text": "Z Bengaluru.", "words": [[238.57, 238.81, " Z"], [238.81, 239.59, " Bengaluru."]]}, {"start": 240.39, "end": 243.71, "text": "244 kilometrów i 4,5 godziny.", "words": [[240.39, 241.15, " 244"], [241.15, 241.75, " kilometrów"], [241.75, 241.95, " i"], [241.95, 242.31, " 4"], [242.31, 242.53, ",5"], [242.53, 243.71, " godziny."]]}, {"start": 243.95, "end": 244.65, "text": "W obie strony.", "words": [[243.95, 244.03, " W"], [244.03, 244.25, " obie"], [244.25, 244.65, " strony."]]}, {"start": 245.03, "end": 246.39, "text": "9 godzin.", "words": [[245.03, 245.41, " 9"], [245.41, 246.39, " godzin."]]}, {"start": 246.77, "end": 248.19, "text": "Werdykt mieści się.", "words": [[246.77, 247.39, " Werdykt"], [247.39, 247.89, " mieści"], [247.89, 248.19, " się."]]}, {"start": 248.19, "end": 251.37, "text": "Moim zdaniem tu autor ma rację.", "words": [[248.19, 249.37, " Moim"], [249.37, 249.81, " zdaniem"], [249.81, 250.05, " tu"], [250.05, 250.39, " autor"], [250.39, 250.67, " ma"], [250.67, 251.37, " rację."]]}, {"start": 251.59, "end": 253.19, "text": "Dwa dni wystarczą.", "words": [[251.59, 251.73, " Dwa"], [251.73, 251.93, " dni"], [251.93, 253.19, " wystarczą."]]}, {"start": 254.45, "end": 254.89, "text": "Mysuru.", "words": [[254.45, 254.89, " Mysuru."]]}, {"start": 255.43, "end": 257.69, "text": "140 kilometrów.", "words": [[255.43, 256.03, " 140"], [256.03, 257.69, " kilometrów."]]}, {"start": 258.05, "end": 258.95, "text": "Najbliżej.", "words": [[258.05, 258.95, " Najbliżej."]]}, {"start": 260.95, "end": 262.15, "text": "Pałac Mysuru.", "words": [[260.95, 261.39, " Pałac"], [261.39, 262.15, " Mysuru."]]}, {"start": 262.97, "end": 263.73, "text": "Autor.", "words": [[262.97, 263.73, " Autor."]]}, {"start": 263.79, "end": 267.19, "text": "Jeden z najczęściej odwiedzanych pałaców w Indiach.", "words": [[263.79, 264.03, " Jeden"], [264.03, 264.17, " z"], [264.17, 264.89, " najczęściej"], [264.89, 265.49, " odwiedzanych"], [265.49, 266.07, " pałaców"], [266.07, 266.35, " w"], [266.35, 267.19, " Indiach."]]}, {"start": 267.49, "end": 269.97, "text": "Fontanny w obrodach Brindavan Pozmoku.", "words": [[267.49, 268.01, " Fontanny"], [268.01, 268.19, " w"], [268.19, 268.65, " obrodach"], [268.65, 269.21, " Brindavan"], [269.21, 269.97, " Pozmoku."]]}, {"start": 270.73, "end": 273.39, "text": "Dla tych świateł warto zostać na noc.", "words": [[270.73, 270.91, " Dla"], [270.91, 271.13, " tych"], [271.13, 271.59, " świateł"], [271.59, 271.95, " warto"], [271.95, 272.45, " zostać"], [272.45, 272.67, " na"], [272.67, 273.39, " noc."]]}, {"start": 273.83, "end": 274.77, "text": "A za dnia.", "words": [[273.83, 274.03, " A"], [274.03, 274.21, " za"], [274.21, 274.77, " dnia."]]}, {"start": 275.03, "end": 276.15, "text": "Alej i Trawniki.", "words": [[275.03, 275.37, " Alej"], [275.37, 275.51, " i"], [275.51, 276.15, " Trawniki."]]}, {"start": 276.15, "end": 278.05, "text": "Z Bengaluru.", "words": [[276.15, 277.15, " Z"], [277.15, 278.05, " Bengaluru."]]}, {"start": 278.63, "end": 281.17, "text": "146 kilometrów i 2,5 godziny.", "words": [[278.63, 279.43, " 146"], [279.43, 280.11, " kilometrów"], [280.11, 280.27, " i"], [280.27, 280.53, " 2"], [280.53, 280.77, ",5"], [280.77, 281.17, " godziny."]]}, {"start": 282.09, "end": 282.91, "text": "W obie strony.", "words": [[282.09, 282.21, " W"], [282.21, 282.51, " obie"], [282.51, 282.91, " strony."]]}, {"start": 283.37, "end": 284.67, "text": "5 godzin.", "words": [[283.37, 283.69, " 5"], [283.69, 284.67, " godzin."]]}, {"start": 285.05, "end": 286.61, "text": "Werdykt mieści się.", "words": [[285.05, 285.71, " Werdykt"], [285.71, 286.13, " mieści"], [286.13, 286.61, " się."]]}, {"start": 287.37, "end": 290.53, "text": "Moim zdaniem tu droga nie jest problemem.", "words": [[287.37, 287.73, " Moim"], [287.73, 288.13, " zdaniem"], [288.13, 288.41, " tu"], [288.41, 288.73, " droga"], [288.73, 288.95, " nie"], [288.95, 289.19, " jest"], [289.19, 290.53, " problemem."]]}, {"start": 291.81, "end": 292.61, "text": "Pocumujmy.", "words": [[291.81, 292.61, " Pocumujmy."]]}, {"start": 293.07, "end": 295.19, "text": "Trzy razy mieści się.", "words": [[293.07, 293.31, " Trzy"], [293.31, 293.99, " razy"], [293.99, 294.37, " mieści"], [294.37, 295.19, " się."]]}, {"start": 295.59, "end": 297.35, "text": "Dwa razy na styk.", "words": [[295.59, 295.85, " Dwa"], [295.85, 296.41, " razy"], [296.41, 296.65, " na"], [296.65, 297.35, " styk."]]}, {"start": 297.91, "end": 299.61, "text": "Raz za daleko.", "words": [[297.91, 298.19, " Raz"], [298.19, 298.55, " za"], [298.55, 299.61, " daleko."]]}, {"start": 299.87, "end": 301.19, "text": "Autor podawał kilometry.", "words": [[299.87, 300.21, " Autor"], [300.21, 300.79, " podawał"], [300.79, 301.19, " kilometry."]]}, {"start": 302.29, "end": 304.27, "text": "Weekend liczy się w godzinach.", "words": [[302.29, 302.79, " Weekend"], [302.79, 303.11, " liczy"], [303.11, 303.33, " się"], [303.33, 303.59, " w"], [303.59, 304.27, " godzinach."]]}, {"start": 304.27, "end": 308.73, "text": "Czasy do jazdu to wartości orientacyjne serwisów podróżniczych.", "words": [[304.27, 305.17, " Czasy"], [305.17, 305.39, " do"], [305.39, 305.71, " jazdu"], [305.71, 305.87, " to"], [305.87, 306.43, " wartości"], [306.43, 307.23, " orientacyjne"], [307.23, 307.83, " serwisów"], [307.83, 308.73, " podróżniczych."]]}, {"start": 309.03, "end": 310.03, "text": "Bez postojów.", "words": [[309.03, 309.21, " Bez"], [309.21, 310.03, " postojów."]]}, {"start": 310.73, "end": 312.25, "text": "Teraz pytanie do Ciebie.", "words": [[310.73, 310.95, " Teraz"], [310.95, 311.35, " pytanie"], [311.35, 311.65, " do"], [311.65, 312.25, " Ciebie."]]}, {"start": 312.85, "end": 315.27, "text": "Ile godzin w aucie jest wartę dwóch dni?", "words": [[312.85, 313.03, " Ile"], [313.03, 313.37, " godzin"], [313.37, 313.59, " w"], [313.59, 313.91, " aucie"], [313.91, 314.17, " jest"], [314.17, 314.67, " wartę"], [314.67, 314.97, " dwóch"], [314.97, 315.27, " dni?"]]}, {"start": 316.27, "end": 321.15, "text": "Napisz w komentarzu, które z tych sześciu miejsc znasz i ile tam jechałeś.", "words": [[316.27, 316.53, " Napisz"], [316.53, 316.75, " w"], [316.75, 317.79, " komentarzu,"], [318.01, 318.07, " które"], [318.07, 318.21, " z"], [318.21, 318.39, " tych"], [318.39, 318.89, " sześciu"], [318.89, 319.13, " miejsc"], [319.13, 319.49, " znasz"], [319.49, 319.77, " i"], [319.77, 320.03, " ile"], [320.03, 320.25, " tam"], [320.25, 321.15, " jechałeś."]]}, {"start": 321.69, "end": 325.93, "text": "A następny film zrobię o miejscu, które dostanie najwięcej głosów.", "words": [[321.69, 321.95, " A"], [321.95, 322.41, " następny"], [322.41, 322.67, " film"], [322.67, 323.09, " zrobię"], [323.09, 323.21, " o"], [323.21, 324.11, " miejscu,"], [324.19, 324.33, " które"], [324.33, 324.79, " dostanie"], [324.79, 325.35, " najwięcej"], [325.35, 325.93, " głosów."]]}]}