{"duration": 69.833375, "segments": [{"start": 0.24, "end": 10.32, "text": "भारत की एक नेकेर स्पोर्ट बाइक, सिंगल सिलेंडर, लिक्विड कूलड इंजन, जिसकी क्षम्ता 199 दश्मलफ पांच सीसी है.", "words": [[0.24, 1.16, " भारत"], [1.16, 1.34, " की"], [1.34, 1.74, " एक"], [1.74, 2.28, " नेकेर"], [2.28, 2.68, " स्पोर्ट"], [2.68, 3.48, " बाइक,"], [3.54, 4.12, " सिंगल"], [4.12, 4.8, " सिलेंडर,"], [4.9, 5.4, " लिक्विड"], [5.4, 5.96, " कूलड"], [5.96, 6.22, " इंजन,"], [6.46, 6.84, " जिसकी"], [6.84, 7.48, " क्षम्ता"], [7.48, 8.38, " 199"], [8.38, 9.2, " दश्मलफ"], [9.2, 9.52, " पांच"], [9.52, 9.92, " सीसी"], [9.92, 10.32, " है."]]}, {"start": 11.8, "end": 17.22, "text": "प्रेस्थ स्टील का पेरिमेटर प्रेम, 17 इंच के अलोई वील और चार वाल्व.", "words": [[11.8, 12.22, " प्रेस्थ"], [12.22, 12.54, " स्टील"], [12.54, 12.76, " का"], [12.76, 13.48, " पेरिमेटर"], [13.48, 13.94, " प्रेम,"], [14.08, 14.44, " 17"], [14.44, 14.76, " इंच"], [14.76, 15.02, " के"], [15.02, 15.32, " अलोई"], [15.32, 15.72, " वील"], [15.72, 16.02, " और"], [16.02, 16.36, " चार"], [16.36, 17.22, " वाल्व."]]}, {"start": 17.22, "end": 25.22, "text": "मौजूदा वर्जन में फ्यूल इंजेक्षन है. इस बाइक में एबी एस है, फोर्क पर लगा लेबल यही बताता है.", "words": [[17.22, 17.94, " मौजूदा"], [17.94, 18.4, " वर्जन"], [18.4, 18.7, " में"], [18.7, 19.24, " फ्यूल"], [19.24, 19.76, " इंजेक्षन"], [19.76, 20.44, " है."], [20.64, 20.88, " इस"], [20.88, 21.26, " बाइक"], [21.26, 21.5, " में"], [21.5, 21.96, " एबी"], [21.96, 22.14, " एस"], [22.14, 22.5, " है,"], [22.66, 23.02, " फोर्क"], [23.02, 23.22, " पर"], [23.22, 23.62, " लगा"], [23.62, 23.98, " लेबल"], [23.98, 24.3, " यही"], [24.3, 24.76, " बताता"], [24.76, 25.22, " है."]]}, {"start": 26.76, "end": 31.16, "text": "अर्जेन्टीना में यह राउजर एन एस 200 के नाम से बिकती है.", "words": [[26.76, 27.48, " अर्जेन्टीना"], [27.48, 27.92, " में"], [27.92, 28.08, " यह"], [28.08, 28.76, " राउजर"], [28.76, 29.08, " एन"], [29.08, 29.28, " एस"], [29.28, 29.64, " 200"], [29.64, 29.92, " के"], [29.92, 30.2, " नाम"], [30.