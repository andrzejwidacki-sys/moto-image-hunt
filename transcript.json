7, " from"], [125.07, 125.47, " above"], [125.47, 125.85, " at"], [125.85, 126.09, " the"], [126.09, 126.31, " Green"], [126.31, 126.65, " River"]]}, {"start": 126.65, "end": 133.07, "text": "Overlook, where the river winds through canyons far below. It feels like a bomb is going off.", "words": [[126.65, 127.23, " Overlook,"], [127.57, 127.69, " where"], [127.69, 127.85, " the"], [127.85, 128.09, " river"], [128.09, 128.43, " winds"], [128.43, 128.77, " through"], [128.77, 129.29, " canyons"], [129.29, 129.61, " far"], [129.61, 130.13, " below."], [131.55, 131.55, " It"], [131.55, 131.77, " feels"], [131.77, 132.09, " like"], [132.09, 132.27, " a"], [132.27, 132.45, " bomb"], [132.45, 132.63, " is"], [132.63, 132.83, " going"], [132.83, 133.07, " off."]]}, {"start": 133.15, "end": 142.69, "text": "The earth shakes and it shoots out all these rocks. The clip shows a daytime eruption,", "words": [[133.15, 133.25, " The"], [133.25, 133.47, " earth"], [133.47, 134.21, " shakes"], [134.21, 135.19, " and"], [135.19, 135.41, " it"], [135.41, 135.61, " shoots"], [135.61, 135.85, " out"], [135.85, 135.99, " all"], [135.99, 137.03, " these"], [137.03, 137.63, " rocks."], [141.05, 141.21, " The"], [141.21, 141.41, " clip"], [141.41, 141.65, " shows"], [141.65, 141.87, " a"], [141.87, 142.17, " daytime"], [142.17, 142.69, " eruption,"]]}, {"start": 142.69, "end": 149.05, "text": "a column of ash rising over the slope. Fuego in Guatemala is almost constantly active.", "words": [[142.69, 143.29, " a"], [143.29, 143.57, " column"], [143.57, 143.79, " of"], [143.79, 144.05, " ash"], [144.05, 144.47, " rising"], [144.47, 144.75, " over"], [144.75, 144.97, " the"], [144.97, 145.27, " slope."], [146.07, 146.27, " Fuego"], [146.27, 146.51, " in"], [146.51, 147.03, " Guatemala"], [147.03, 147.49, " is"], [147.49, 148.01, " almost"], [148.01, 148.53, " constantly"], [148.53, 149.05, " active."]]}, {"start": 149.63, "end": 155.65, "text": "A small explosion leaves the crater every 15 to 20 minutes. At night the crater glows red,", "words": [[149.63, 149.77, " A"], [149.77, 150.09, " small"], [150.09, 150.71, " explosion"], [150.71, 151.07, " leaves"], [151.07, 151.33, " the"], [151.33, 151.51, " crater"], [151.51, 151.99, " every"], [151.99, 152.49, " 15"], [152.49, 152.65, " to"], [152.65, 152.91, " 20"], [152.91, 153.45, " minutes."], [153.97, 154.21, " At"], [154.21, 154.41, " night"], [154.41, 154.57, " the"], [154.57, 154.89, " crater"], [154.89, 155.29, " glows"], [155.29, 155.65, " red,"]]}, {"start": 156.09, "end": 162.13, "text": "as in this photograph from November 2017, while larger eruptions, over 80 since 1999,", "words": [[156.09, 156.19, " as"], [156.19, 156.41, " in"], [156.41, 156.59, " this"], [156.59, 157.05, " photograph"], [157.05, 157.25, " from"], [157.25, 157.69, " November"], [157.69, 158.61, " 2017,"], [159.05, 159.29, " while"], [159.29, 159.65, " larger"], [159.65, 160.29, " eruptions,"], [160.59, 160.83, " over"], [160.83, 161.01, " 80"], [161.01, 161.31, " since"], [161.31, 162.13, " 1999,"]]}, {"start": 162.61, "end": 169.39, "text": "are much rarer. A day after the eruption of the 31st of January 2018, the Landsat 8", "words": [[162.61, 162.77, " are"], [162.77, 163.15, " much"], [163.15, 163.91, " rarer."], [164.19, 164.33, " A"], [164.33, 164.45, " day"], [164.45, 164.73, " after"], [164.73, 164.91, " the"], [164.91, 165.29, " eruption"], [165.29, 165.51, " of"], [165.51, 165.65, " the"], [165.65, 166.31, " 31st"], [166.31, 166.47, " of"], [166.47, 167.05, " January"], [167.05, 168.01, " 2018,"], [168.57, 168.71, " the"], [168.71, 169.15, " Landsat"], [169.15, 169.39, " 8"]]}, {"start": 169.39, "end": 176.03, "text": "satellite photographed a plume of ash trailing from the volcano. Gets me very excited,", "words": [[169.39, 170.03, " satellite"], [170.03, 170.75, " photographed"], [170.75, 171.05, " a"], [171.05, 171.25, " plume"], [171.25, 171.43, " of"], [171.43, 171.71, " ash"], [171.71, 172.13, " trailing"], [172.13, 172.33, " from"], [172.33, 172.49, " the"], [172.49, 173.01, " volcano."], [174.35, 174.69, " Gets"], [174.69, 175.01, " me"], [175.01, 175.53, " very"], [175.53, 176.03, " excited,"]]}, {"start": 176.39, "end": 185.78, "text": "but especially this one, the Copper Canyons of Northern Mexico. This clip shows a viewpoint", "words": [[176.39, 176.49, " but"], [176.49, 177.15, " especially"], [177.15, 177.59, " this"], [177.59, 177.81, " one,"], [178.11, 178.39, " the"], [178.39, 178.79, " Copper"], [178.79, 179.39, " Canyons"], [179.39, 179.83, " of"], [179.83, 180.45, " Northern"], [180.45, 181.27, " Mexico."], [184.44, 184.86, " This"], [184.86, 185.08, " clip"], [185.08, 185.32, " shows"], [185.32, 185.52, " a"], [185.52, 185.78, " viewpoint"]]}, {"start": 185.78, "end": 190.24, "text": "with a shelter on the edge and then a single slope of the canyon filmed from above.", "words": [[185.78, 186.08, " with"], [186.08, 186.3, " a"], [186.3, 186.52, " shelter"], [186.52, 186.72, " on"], [186.72, 186.92, " the"], [186.92, 187.16, " edge"], [187.16, 187.7, " and"], [187.7, 187.86, " then"], [187.86, 188.1, " a"], [188.1, 188.42, " single"], [188.42, 188.64, " slope"], [188.64, 188.8, " of"], [188.8, 189.0, " the"], [189.0, 189.24, " canyon"], [189.24, 189.62, " filmed"], [189.62, 189.86, " from"], [189.86, 190.24, " above."]]}, {"start": 190.94, "end": 196.8, "text": "But Copper Canyon is not one canyon. It is a system of six canyons cut by six rivers,", "words": [[190.94, 191.12, " But"], [191.12, 191.4, " Copper"], [191.4, 191.8, " Canyon"], [191.8, 192.14, " is"], [192.14, 192.42, " not"], [192.42, 192.64, " one"], [192.64, 193.02, " canyon."], [193.5, 193.72, " It"], [193.72, 193.98, " is"], [193.98, 194.1, " a"], [194.1, 194.4, " system"], [194.4, 194.7, " of"], [194.7, 194.98, " six"], [194.98, 195.44, " canyons"], [195.44, 195.72, " cut"], [195.72, 196.02, " by"], [196.02, 196.3, " six"], [196.3, 196.8, " rivers,"]]}, {"start": 196.8, "end": 203.52, "text":