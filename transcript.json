 old"], [45.44, 45.74, " pier."], [46.2, 46.46, " People"], [46.46, 46.74, " are"], [46.74, 47.0, " swimming"], [47.0, 47.22, " in"], [47.22, 47.38, " the"], [47.38, 47.54, " sea"], [47.54, 47.9, " despite"], [47.9, 48.14, " the"], [48.14, 48.4, " surf."]]}, {"start": 48.82, "end": 51.54, "text": "The French Quarter, a house with columns and palms.", "words": [[48.82, 49.02, " The"], [49.02, 49.24, " French"], [49.24, 49.62, " Quarter,"], [50.0, 50.12, " a"], [50.12, 50.32, " house"], [50.32, 50.58, " with"], [50.58, 50.92, " columns"], [50.92, 51.16, " and"], [51.16, 51.54, " palms."]]}, {"start": 51.54, "end": 58.18, "text": "From Bangalore, about 300 kilometers and seven hours. Round trip, 14 hours in the car.", "words": [[51.54, 52.08, " From"], [52.08, 52.88, " Bangalore,"], [53.28, 53.36, " about"], [53.36, 53.86, " 300"], [53.86, 54.46, " kilometers"], [54.46, 54.82, " and"], [54.82, 55.1, " seven"], [55.1, 55.8, " hours."], [56.1, 56.26, " Round"], [56.26, 56.56, " trip,"], [56.78, 57.18, " 14"], [57.18, 57.46, " hours"], [57.46, 57.62, " in"], [57.62, 57.78, " the"], [57.78, 58.18, " car."]]}, {"start": 58.76, "end": 62.1, "text": "Verdict, tight. My read, this is a three-day trip.", "words": [[58.76, 59.06, " Verdict,"], [59.22, 59.42, " tight."], [60.14, 60.32, " My"], [60.32, 60.58, " read,"], [60.76, 60.98, " this"], [60.98, 61.16, " is"], [61.16, 61.34, " a"], [61.34, 61.54, " three"], [61.54, 61.7, "-day"], [61.7, 62.1, " trip."]]}, {"start": 63.56, "end": 67.04, "text": "Korg, 250 kilometers. The author says, only.", "words": [[63.56, 64.08, " Korg,"], [64.08, 64.6, " 250"], [64.6, 65.18, " kilometers."], [65.68, 65.92, " The"], [65.92, 66.16, " author"], [66.16, 66.32, " says,"], [66.72, 67.04, " only."]]}, {"start": 69.32, "end": 74.18, "text": "This is the view from Rajah's seat, in Madikerry. In the video, the hilltop was", "words": [[69.32, 69.56, " This"], [69.56, 69.8, " is"], [69.8, 69.9, " the"], [69.9, 70.04, " view"], [70.04, 70.3, " from"