{"duration": 363.1666875, "segments": [{"start": 0.34, "end": 7.44, "text": "Komentarz do filmu podróżniczego Riana Van Dusera na licencji Creative Commons – uznanie autorstwa.", "words": [[0.34, 1.34, " Komentarz"], [1.34, 1.54, " do"], [1.54, 1.9, " filmu"], [1.9, 2.48, " podróżniczego"], [2.48, 2.82, " Riana"], [2.82, 3.1, " Van"], [3.1, 3.52, " Dusera"], [3.52, 3.98, " na"], [3.98, 4.5, " licencji"], [4.5, 5.02, " Creative"], [5.02, 5.66, " Commons"], [5.66, 6.14, " –"], [6.14, 6.54, " uznanie"], [6.54, 7.44, " autorstwa."]]}, {"start": 8.02, "end": 13.84, "text": "Oglądamy po 7 sekund z każdego miejsca, a potem sprawdzamy, jak ono naprawdę wygląda.", "words": [[8.02, 8.52, " Oglądamy"], [8.52, 8.78, " po"], [8.78, 9.04, " 7"], [9.04, 9.52, " sekund"], [9.52, 9.74, " z"], [9.74, 10.04, " każdego"], [10.04, 10.68, " miejsca,"], [10.84, 11.02, " a"], [11.02, 11.28, " potem"], [11.28, 12.08, " sprawdzamy,"], [12.4, 12.56, " jak"], [12.56, 12.86, " ono"], [12.86, 13.32, " naprawdę"], [13.32, 13.84, " wygląda."]]}, {"start": 25.25, "end": 29.65, "text": "Na ekranie widać zbliżenia szczytów, małe jezioro i flagi modlitewne.", "words": [[25.25, 25.45, " Na"], [25.45, 25.87, " ekranie"], [25.87, 26.19, " widać"], [26.19, 26.73, " zbliżenia"], [26.73, 27.41, " szczytów,"], [27.75, 27.93, " małe"], [27.93, 28.33, " jezioro"], [28.33, 28.49, " i"], [28.49, 28.83, " flagi"], [28.83, 29.65, " modlitewne."]]}, {"start": 30.25, "end": 40.37, "text": "A tak wygląda Amadablam, 6812 metrów, która przez kilka dni dominuje na wschodnim niebie każdemu, kto idzie do bazy pod Everestem.", "words": [[30.25, 30.43, " A"], [30.43, 30.61, " tak"], [30.61, 31.01, " wygląda"], [31.01, 31.87, " Amadablam,"], [32.17, 34.05, " 6812"], [34.05, 34.99, " metrów,"], [35.11, 35.27, " która"], [35.27, 35.55, " przez"], [35.55, 35.89, " kilka"], [35.89, 36.11, " dni"], [36.11, 36.61, " dominuje"], [36.61, 36.79, " na"], [36.79, 37.27, " wschodnim"], [37.27, 37.59, " niebie"], [37.59, 38.41, " każdemu,"], [38.49, 38.69, " kto"], [38.69, 38.93, " idzie"], [38.93, 39.17, " do"], [39.17, 39.41, " bazy"], [39.41, 39.63, " pod"], [39.63, 40.37, " Everestem."]]}, {"start": 40.37, "end": 48.89, "text": "A to jeziora Gokio w Parku Narodowym Sagarmata, na wysokości od 4700 do 5000 metrów.", "words": [[40.37, 41.01, " A"], [41.01, 41.19, " to"], [41.19, 41.55, " jeziora"], [41.55, 41.87, " Gokio"], [41.87, 42.03, " w"], [42.03, 42.49, " Parku"], [42.49, 42.99, " Narodowym"], [42.99, 43.81, " Sagarmata,"], [44.21, 44.31, " na"], [44.31, 44.89, " wysokości"], [44.89, 45.23, " od"], [45.23, 46.63, " 4700"], [46.63, 46.91, " do"], [46.91, 47.55, " 5000"], [47.55, 48.89, " metrów."]]}, {"start": 49.23, "end": 54.67, "text": "Zobacz dwie malutkie postacie na zboczu, to jest prawdziwa skala tego krajobrazu.", "words": [[49.23, 49.57, " Zobacz"], [49.57, 49.85, " dwie"], [49.85, 50.37, " malutkie"], [50.37, 50.83, " postacie"], [50.83, 51.03, " na"], [51.03, 51.63, " zboczu,"], [51.93, 52.05, " to"], [52.05, 52.31, " jest"], [52.31, 52.81, " prawdziwa"], [52.81, 53.15, " skala"], [53.15, 53.45, " tego"], [53.45, 54.67, " krajobrazu."]]}, {"start": 65.66, "end": 69.8, "text": "W tym fragmencie widać piechurów i obóz, ale nie samą cytadele.", "words": [[65.66, 65.68, " W"], [65.68, 65.96, " tym"], [65.96, 66.52, " fragmencie"], [66.52, 66.86, " widać"], [66.86, 67.5, " piechurów"], [67.5, 67.74, " i"], [67.74, 68.32, " obóz,"], [68.44, 68.56, " ale"], [68.56, 68.8, " nie"], [68.8, 69.18, " samą"], [69.18, 69.8, " cytadele."]]}, {"start": 70.44, "end": 78.26, "text": "Tak naprawdę wygląda Machu Picchu, kamienne tarasy i domy na grzbiecie, a za nimi szczyt, często owinięty chmurami.", "words": [[70.44, 70.68, " Tak"], [70.68, 71.2, " naprawdę"], [71.2, 71.72, " wygląda"], [71.72, 72.26, " Machu"], [72.26, 72.7, " Picchu,"], [72.98, 73.36, " kamienne"], [73.36, 73.9, " tarasy"], [73.9, 74.36, " i"], [74.36, 74.6, " domy"], [74.6, 74.7, " na"], [74.7, 75.24, " grzbiecie,"], [75.62, 75.76, " a"], [75.76, 75.84, " za"], [75.84, 76.06, " nimi"], [76.06, 76.76, " szczyt,"], [76.92, 77.18, " często"], [77.18, 77.7, " owinięty"], [77.7, 78.26, " chmurami."]]}, {"start": 78.76, "end": 91.24, "text": "Zjęcie z wyprawy Hiramabindama z 1912 roku pokazuje to samo miejsce jak o Pole Gruzu, jeszcze przed renowacją z lat 1929 do 1971.", "words": [[78.76, 79.46, " Zjęcie"], [79.46, 79.66, " z"], [79.66, 80.16, " wyprawy"], [80.16, 80.9, " Hiramabindama"], [80.9, 81.12, " z"], [81.12, 82.32, " 1912"], [82.32, 82.82, " roku"], [82.82, 83.6, " pokazuje"], [83.6, 83.9, " to"], [83.9, 84.18, " samo"], [84.18, 84.54, " miejsce"], [84.54, 84.78, " jak"], [84.78, 84.92, " o"], [84.92, 85.08, " Pole"], [85.08, 85.66, " Gruzu,"], [85.96, 86.1, " jeszcze"], [86.1, 86.36, " przed"], [86.36, 87.0, " renowacją"], [87.0, 87.12, " z"], [87.12, 87.38, " lat"], [87.38, 89.04, " 1929"], [89.04, 89.7, " do"], [89.7, 91.24, " 1971."]]}, {"start": 92.44, "end": 98.62, "text": "Dziś do cytadeli wchodzi dziennie do 4500 osób, a w szczycie sezonu do 5600.", "words": [[92.44, 92.62, " Dziś"], [92.62, 92.76, " do"], [92.76, 93.22, " cytadeli"], [93.22, 93.6, " wchodzi"], [93.6, 93.96, " dziennie"], [93.96, 94.12, " do"], [94.12, 95.52, " 4500"], [95.52, 96.02, " osób,"], [96.28, 96.42, " a"], [96.42, 96.5, " w"], [96.5, 96.8, " szczycie"], [96.8, 97.22, " sezonu"], [97.22, 97.3, " do"], [97.3, 98.62, " 5600."]]}, {"start": 110.18, "end": 114.56, "text": "Na ekranie widać dwóch rowerzystów na polnej drodze i czerwoną mezę w tle.", "words": [[110.18, 110.46, " Na"], [110.46, 110.84, " ekranie"], [110.84, 111.14, " widać"], [111.14, 111.52, " dwóch"], [111.52, 112.16, " rowerzystów"], [112.16, 112.38, " na"], [112.38, 112.78, " polnej"], [112.78, 113.08, " drodze"], [113.08, 113.22, " i"], [113.22, 113.88, " czerwoną"], [113.88, 114.12, " mezę"], [114.12, 114.3, " w"], [114.3, 114.56, " tle."]]}, {"start": 114.56, "end": 123.82, "text": "To droga White Rim w Parku Narodowym Canyonance, 71 mil, czyli około 115 km drogi bez asfaltu.", "words": [[114.56, 115.4, " To"], [115.4, 115.76, " droga"], [115.76, 116.04, " White"], [116.04, 116.26, " Rim"], [116.26, 116.44, " w"], [116.44, 116.86, " Parku"], [116.86, 117.4, " Narodowym"], [117.4, 118.14, " Canyonance,"], [118.42, 119.08, " 71"], [119.08, 119.54, " mil,"], [119.88, 120.14, " czyli"], [120.14, 120.64, " około"], [120.64, 121.16, " 115"], [121.16, 122.0, " km"], [122.0, 122.38, " drogi"], [122.38, 122.6, " bez"], [122.6, 123.82, " asfaltu."]]}, {"start": 123.96, "end": 131.84, "text": "Poprowadzono ją w latach 50. pod szczytem Messy Island in the sky, żeby poszukiwacze uraną mogli tam dojechać.", "words": [[123.96, 124.62, " Poprowadzono"], [124.62, 124.8, " ją"], [124.8, 124.9, " w"], [124.9, 125.3, " latach"], [125.3, 125.8, " 50."], [126.0, 126.18, " pod"], [126.18, 126.64, " szczytem"], [126.64, 127.06, " Messy"], [127.06, 127.42, " Island"], [127.42, 127.74, " in"], [127.74, 127.88, " the"], [127.88, 128.28, " sky,"], [128.68, 128.88, " żeby"], [128.88, 129.74, " poszukiwacze"], [129.74, 130.12, " uraną"], [130.12, 130.44, " mogli"], [130.44, 130.64, " tam"], [130.64, 131.84, " dojechać."]]}, {"start": 132.02, "end": 139.6, "text": "A tak ten krajobraz gląda z góry, z punktu widokowego nad rzeką Green River, gdzie rzeka płynie wśród kanionów daleko w dole.", "words": [[132.02, 132.18, " A"], [132.18, 132.36, " tak"], [132.36, 132.6, " ten"], [132.6, 133.1, " krajobraz"], [133.1, 133.54, " gląda"], [133.54, 133.78, " z"], [133.78, 134.28, " góry,"], [134.44, 134.52, " z"], [134.52, 134.94, " punktu"], [134.94, 135.46, " widokowego"], [135.46, 135.68, " nad"], [135.68, 136.1, " rzeką"], [136.1, 136.32, " Green"], [136.32, 136.66, " River,"], [136.88, 137.04, " gdzie"], [137.04, 137.44, " rzeka"], [137.44, 137.76, " płynie"], [137.76, 138.12, " wśród"], [138.12, 138.6, " kanionów"], [138.6, 139.02, " daleko"], [139.02, 139.22, " w"], [139.22, 139.6, " dole."]]}, {"start": 150.0, "end": 155.36, "text": "Na ekranie widać erupcję w ciągu dnia, kolumnę popiołu nad zboczem.", "words": [[150.0, 150.8, " Na"], [150.8, 151.18, " ekranie"], [151.18, 151.48, " widać"], [151.48, 151.98, " erupcję"], [151.98, 152.16, " w"], [152.16, 152.52, " ciągu"], [152.52, 153.12, " dnia,"], [153.36, 153.72, " kolumnę"], [153.72, 154.14, " popiołu"], [154.14, 154.38, " nad"], [154.38, 155.36, " zboczem."]]}, {"start": 155.64, "end": 162.1, "text": "Płego w Guatemala jest niema stale aktywny, mały wybuch z krateru zdarza się co 15 do 20 minut.", "words": [[155.64, 155.88, " Płego"], [155.88, 156.02, " w"], [156.02, 156.5, " Guatemala"], [156.5, 156.84, " jest"], [156.84, 157.18, " niema"], [157.18, 157.4, " stale"], [157.4, 158.02, " aktywny,"], [158.48, 158.74, " mały"], [158.74, 158.96, " wybuch"], [158.96, 159.16, " z"], [159.16, 159.6, " krateru"], [159.6, 159.88, " zdarza"], [159.88, 160.08, " się"], [160.08, 160.28, " co"], [160.28, 160.82, " 15"], [160.82, 161.04, " do"], [161.04, 161.46, " 20"], [161.46, 162.1, " minut."]]}, {"start": 162.76, "end": 176.2, "text": "W nocy krater żarzy się na czerwoną, jak na ten zdjęciu z listopada 2017 roku, a większe erupcje, ponad 80 od 1999 roku, zdarzają się dużo rzadziej.", "words": [[162.76, 162.98, " W"], [162.98, 163.24, " nocy"], [163.24, 163.62, " krater"], [163.62, 163.98, " żarzy"], [163.98, 164.14, " się"], [164.14, 164.34, " na"], [164.34, 165.18, " czerwoną,"], [165.32, 165.52, " jak"], [165.52, 165.72, " na"], [165.72, 165.88, " ten"], [165.88, 166.26, " zdjęciu"], [166.26, 166.4, " z"], [166.4, 166.92, " listopada"], [166.92, 167.98, " 2017"], [167.98, 168.64, " roku,"], [168.92, 169.14, " a"], [169.14, 169.5, " większe"], [169.5, 170.38, " erupcje,"], [170.56, 170.92, " ponad"], [170.92, 171.48, " 80"], [171.48, 171.82, " od"], [171.82, 173.26, " 1999"], [173.26, 174.64, " roku,"], [174.86, 175.26, " zdarzają"], [175.26, 175.44, " się"], [175.44, 175.74, " dużo"], [175.74, 176.2, " rzadziej."]]}, {"start": 176.2, "end": 186.32, "text": "Dzień po erupcji z 31 stycznia 2018 roku satelita Lensat 8 sfotografował smugę popiołu ciągnącą się z nadwulkanu.", "words": [[176.2, 177.24, " Dzień"], [177.24, 177.42, " po"], [177.42, 177.94, " erupcji"], [177.94, 178.1, " z"], [178.1, 178.9, " 31"], [178.9, 179.7, " stycznia"], [179.7, 180.74, " 2018"], [180.74, 181.32, " roku"], [181.32, 181.84, " satelita"], [181.84, 182.32, " Lensat"], [182.32, 182.58, " 8"], [182.58, 183.34, " sfotografował"], [183.34, 183.8, " smugę"], [183.8, 184.3, " popiołu"], [184.3, 184.76, " ciągnącą"], [184.76, 184.94, " się"], [184.94, 185.04, " z"], [185.04, 186.32, " nadwulkanu."]]}, {"start": 197.21, "end": 203.73, "text": "Ten fragment pokazuje punkt widokowy z wiatą na krawędzi, a potem jeden stok kanionu sfilmowany z góry.", "words": [[197.21, 197.51, " Ten"], [197.51, 197.97, " fragment"], [197.97, 198.55, " pokazuje"], [198.55, 198.97, " punkt"], [198.97, 199.49, " widokowy"], [199.49, 199.63, " z"], [199.63, 199.93, " wiatą"], [199.93, 200.17, " na"], [200.17, 200.91, " krawędzi,"], [201.09, 201.23, " a"], [201.23, 201.47, " potem"], [201.47, 201.81, " jeden"], [201.81, 202.07, " stok"], [202.07, 202.49, " kanionu"], [202.49, 202.99, " sfilmowany"], [202.99, 203.23, " z"], [203.23, 203.73, " góry."]]}, {"start": 204.15, "end": 214.71, "text": "Ale kanion myzany to nie jeden kanion, to system sześciu kanionów wyżłubionych przez sześć rzek o powierzchni 65 tysięcy kilometrów kwadratowych w Sierra Madre Zachodniej.", "words": [[204.15, 204.45, " Ale"], [204.45, 204.77, " kanion"], [204.77, 205.17, " myzany"], [205.17, 205.35, " to"], [205.35, 205.49, " nie"], [205.49, 205.77, " jeden"], [205.77, 206.27, " kanion,"], [206.61, 206.75, " to"], [206.75, 207.07, " system"], [207.07, 207.59, " sześciu"], [207.59, 207.93, " kanionów"], [207.93, 208.55, " wyżłubionych"], [208.55, 208.87, " przez"], [208.87, 209.17, " sześć"], [209.17, 209.63, " rzek"], [209.63, 209.95, " o"], [209.95, 210.37, " powierzchni"], [210.37, 211.17, " 65"], [211.17, 212.05, " tysięcy"], [212.05, 212.73, " kilometrów"], [212.73, 213.41, " kwadratowych"], [213.41, 213.57, " w"], [213.57, 213.77, " Sierra"], [213.77, 214.09, " Madre"], [214.09, 214.71, " Zachodniej."]]}, {"start": 214.71, "end": 220.67, "text": "Z góry wygląda to jak labirynt brzbietów i wąwozów, który ciągnie się aż po horyzont.", "words": [[214.71, 215.43, " Z"], [215.43, 215.77, " góry"], [215.77, 216.19, " wygląda"], [216.19, 216.37, " to"], [216.37, 216.61, " jak"], [216.61, 217.13, " labirynt"], [217.13, 217.69, " brzbietów"], [217.69, 217.87, " i"], [217.87, 218.67, " wąwozów,"], [218.85, 219.05, " który"], [219.05, 219.43, " ciągnie"], [219.43, 219.59, " się"], [219.59, 219.81, " aż"], [219.81, 219.99, " po"], [219.99, 220.67, " horyzont."]]}, {"start": 232.08, "end": 238.75, "text": "Z lotu ptaka, tak jak na ekranie, Black Rock City wygląda jak uporządkowany układ ulic pośrodku pustyni.", "words": [[232.08, 232.24, " Z"], [232.24, 232.58, " lotu"], [232.58, 233.2, " ptaka,"], [233.48, 233.6, " tak"], [233.6, 233.74, " jak"], [233.74, 233.98, " na"], [233.98, 234.74, " ekranie,"], [234.92, 235.08, " Black"], [235.08, 235.24, " Rock"], [235.24, 235.52, " City"], [235.52, 235.98, " wygląda"], [235.98, 236.24, " jak"], [236.24, 237.08, " uporządkowany"], [237.08, 237.44, " układ"], [237.44, 237.8, " ulic"], [237.8, 238.4, " pośrodku"], [238.4, 238.75, " pustyni."]]}, {"start": 239.52, "end": 250.5, "text": "W 2019 roku wzięło w nim udział 78 tysięcy 850 osób przez 9 dni do amerykańskiego święta pracy na pustyni Black Rock w Nevadze.", "words": [[239.52, 239.72, " W"], [239.72, 240.84, " 2019"], [240.84, 241.34, " roku"], [241.34, 241.62, " wzięło"], [241.62, 241.72, " w"], [241.72, 241.9, " nim"], [241.9, 242.28, " udział"], [242.28, 243.26, " 78"], [243.26, 243.86, " tysięcy"], [243.86, 244.92, " 850"], [244.92, 245.62, " osób"], [245.62, 246.02, " przez"], [246.02, 246.3, " 9"], [246.3, 246.5, " dni"], [246.5, 246.76, " do"], [246.76, 247.5, " amerykańskiego"], [247.5, 247.98, " święta"], [247.98, 248.36, " pracy"], [248.36, 248.9, " na"], [248.9, 249.36, " pustyni"], [249.36, 249.64, " Black"], [249.64, 249.82, " Rock"], [249.82, 249.96, " w"], [249.96, 250.5, " Nevadze."]]}, {"start": 250.5, "end": 259.12, "text": "Na ziemi obraz jest inny, w powieczu wisi kurz, a miasto widać z środka roweru, jak na tym zdjęciu z 2012 roku.", "words": [[250.5, 251.4, " Na"], [251.4, 251.68, " ziemi"], [251.68, 252.14, " obraz"], [252.14, 252.44, " jest"], [252.44, 253.04, " inny,"], [253.2, 253.34, " w"], [253.34, 253.78, " powieczu"], [253.78, 254.0, " wisi"], [254.0, 254.24, " kurz,"], [254.54, 254.64, " a"], [254.64, 254.88, " miasto"], [254.88, 255.18, " widać"], [255.18, 255.34, " z"], [255.34, 255.68, " środka"], [255.68, 256.4, " roweru,"], [256.48, 256.68, " jak"], [256.68, 256.82, " na"], [256.82, 257.0, " tym"], [257.0, 257.42, " zdjęciu"], [257.42, 257.62, " z"], [257.62, 258.42, " 2012"], [258.42, 259.12, " roku."]]}, {"start": 270.5, "end": 277.26, "text": "Na ekranie widać gałąź na pierwszym planie, a za nią rozmyty kanion, potem zamglony szeroki widok.", "words": [[270.5, 270.6, " Na"], [270.6, 271.0, " ekranie"], [271.0, 271.34, " widać"], [271.34, 271.8, " gałąź"], [271.8, 271.96, " na"], [271.96, 272.56, " pierwszym"], [272.56, 273.1, " planie,"], [273.32, 273.42, " a"], [273.42, 273.56, " za"], [273.56, 273.74, " nią"], [273.74, 274.2, " rozmyty"], [274.2, 274.9, " kanion,"], [275.1, 275.36, " potem"], [275.36, 275.9, " zamglony"], [275.9, 276.38, " szeroki"], [276.38, 277.26, " widok."]]}, {"start": 277.48, "end": 286.78, "text": "Wielki kanion ma 277 mil, czyli 446 kilometrów długości, do 18 mil szerokości i ponad mile głębokości.", "words": [[277.48, 277.92, " Wielki"], [277.92, 278.18, " kanion"], [278.18, 278.38, " ma"], [278.38, 279.7, " 277"], [279.7, 279.94, " mil,"], [280.16, 280.5, " czyli"], [280.5, 281.58, " 446"], [281.58, 282.5, " kilometrów"], [282.5, 283.22, " długości,"], [283.58, 283.76, " do"], [283.76, 284.22, " 18"], [284.22, 284.54, " mil"], [284.54, 285.26, " szerokości"], [285.26, 285.42, " i"], [285.42, 285.68, " ponad"], [285.68, 285.88, " mile"], [285.88, 286.78, " głębokości."]]}, {"start": 286.78, "end": 292.04, "text": "Na szlaku Bright Angel ścieżka to tylko ciemka linia zakosów na ścianie kanionu.", "words": [[286.78, 287.52, " Na"], [287.52, 287.96, " szlaku"], [287.96, 288.36, " Bright"], [288.36, 288.76, " Angel"], [288.76, 289.28, " ścieżka"], [289.28, 289.46, " to"], [289.46, 289.84, " tylko"], [289.84, 290.24, " ciemka"], [290.24, 290.52, " linia"], [290.52, 291.04, " zakosów"], [291.04, 291.24, " na"], [291.24, 291.62, " ścianie"], [291.62, 292.04, " kanionu."]]}, {"start": 292.8, "end": 300.06, "text": "A o zachody słońca pojedynczy turysta pokazuje skalę, podczas gdy skalne świątynie poniżej łapią ostatnie światło.", "words": [[292.8, 292.92, " A"], [292.92, 293.02, " o"], [293.02, 293.32, " zachody"], [293.32, 293.86, " słońca"], [293.86, 294.34, " pojedynczy"], [294.34, 294.78, " turysta"], [294.78, 295.28, " pokazuje"], [295.28, 296.2, " skalę,"], [296.36, 296.68, " podczas"], [296.68, 296.94, " gdy"], [296.94, 297.36, " skalne"], [297.36, 297.86, " świątynie"], [297.86, 298.34, " poniżej"], [298.34, 298.84, " łapią"], [298.84, 299.4, " ostatnie"], [299.4, 300.06, " światło."]]}, {"start": 311.58, "end": 316.78, "text": "Film zaczyna się od zbliżeń liści, a potem pokazuje dwa wulkany daleko za jezierem.", "words": [[311.58, 311.74, " Film"], [311.74, 312.22, " zaczyna"], [312.22, 312.44, " się"], [312.44, 312.66, " od"], [312.66, 313.16, " zbliżeń"], [313.16, 313.62, " liści,"], [313.96, 314.1, " a"], [314.1, 314.38, " potem"], [314.38, 314.88, " pokazuje"], [314.88, 315.14, " dwa"], [315.14, 315.6, " wulkany"], [315.6, 316.02, " daleko"], [316.02, 316.24, " za"], [316.24, 316.78, " jezierem."]]}, {"start": 316.78, "end": 323.94, "text": "Ometepe to jedna wyspa zbudowana z dwóch wulkanów, Concepcion i Maderas, połączonych niskim przesmykiem.", "words": [[316.78, 317.94, " Ometepe"], [317.94, 318.1, " to"], [318.1, 318.36, " jedna"], [318.36, 318.66, " wyspa"], [318.66, 319.24, " zbudowana"], [319.24, 319.46, " z"], [319.46, 319.74, " dwóch"], [319.74, 320.56, " wulkanów,"], [320.74, 321.2, " Concepcion"], [321.2, 321.48, " i"], [321.48, 321.98, " Maderas,"], [322.32, 322.9, " połączonych"], [322.9, 323.22, " niskim"], [323.22, 323.94, " przesmykiem."]]}, {"start": 324.36, "end": 328.88, "text": "Ma 31 kilometrów długości i od 5 do 10 szerokości.", "words": [[324.36, 324.44, " Ma"], [324.44, 325.26, " 31"], [325.26, 326.0, " kilometrów"], [326.0, 326.62, " długości"], [326.62, 326.94, " i"], [326.94, 327.1, " od"], [327.1, 327.4, " 5"], [327.4, 327.56, " do"], [327.56, 328.04, " 10"], [328.04, 328.88, " szerokości."]]}, {"start": 329.48, "end": 336.2, "text": "Concepcion to aktywny wulkan o symetrycznym stożku, a jego podstawa ma 16 kilometrów średnicy.", "words": [[329.48, 330.14, " Concepcion"], [330.14, 330.54, " to"], [330.54, 331.1, " aktywny"], [331.1, 331.5, " wulkan"], [331.5, 331.74, " o"], [331.74, 332.42, " symetrycznym"], [332.42, 333.0, " stożku,"], [333.32, 333.42, " a"], [333.42, 333.58, " jego"], [333.58, 334.04, " podstawa"], [334.04, 334.18, " ma"], [334.18, 334.74, " 16"], [334.74, 335.5, " kilometrów"], [335.5, 336.2, " średnicy."]]}, {"start": 336.86, "end": 340.86, "text": "Zbocza porasta gęsta zieleń, a wyżej grzbiet znika w chmurach.", "words": [[336.86, 337.38, " Zbocza"], [337.38, 337.76, " porasta"], [337.76, 338.24, " gęsta"], [338.24, 338.82, " zieleń,"], [339.04, 339.2, " a"], [339.2, 339.4, " wyżej"], [339.4, 339.84, " grzbiet"], [339.84, 340.2, " znika"], [340.2, 340.36, " w"], [340.36, 340.86, " chmurach."]]}]}