 [46.42, 46.68, " slope."], [47.08, 47.32, " That"], [47.32, 47.52, " is"], [47.52, 47.72, " the"], [47.72, 48.0, " real"], [48.0, 48.28, " scale"], [48.28, 48.42, " of"], [48.42, 48.62, " this"], [48.62, 49.22, " landscape."]]}, {"start": 50.68, "end": 53.88, "text": "And once we got to Machu Picchu, wow, I mean,", "words": [[50.68, 50.72, " And"], [50.72, 50.94, " once"], [50.94, 51.14, " we"], [51.14, 51.4, " got"], [51.4, 51.72, " to"], [51.72, 52.08, " Machu"], [52.08, 52.66, " Picchu,"], [52.82, 53.3, " wow,"], [53.3, 53.54, " I"], [53.54, 53.88, " mean,"]]}, {"start": 53.88, "end": 57.48, "text": "it's one of the seven wonders of the world for a very good reason.", "words": [[53.88, 54.32, " it's"], [54.32, 54.48, " one"], [54.48, 54.58, " of"], [54.58, 54.78, " the"], [54.78, 55.02, " seven"], [55.02, 55.3, " wonders"], [55.3, 55.52, " of"], [55.52, 55.66, " the"], [55.66, 56.06, " world"], [56.06, 56.46, " for"], [56.46, 56.56, " a"], [56.56, 56.86, " very"], [56.86, 57.04, " good"], [57.04, 57.48, " reason."]]}, {"start": 60.72, "end": 64.36, "text": "This window shows trekkers and a camp, but not the citadel itself.", "words": [[60.72, 60.94, " This"], [60.94, 61.32, " window"], [61.32, 61.64, " shows"], [61.64, 62.12, " trekkers"], [62.12, 62.28, " and"], [62.28, 62.46, " a"], [62.46, 62.68, " camp,"], [62.88, 63.12, " but"], [63.12, 63.38, " not"], [63.38, 63.54, " the"], [63.54, 63.82, " citadel"], [63.82, 64.36, " itself."]]}, {"start": 65.02, "end": 67.36, "text": "This is what Machu Picchu really looks like.", "words": [[65.02, 65.22, " This"], [65.22, 65.42, " is"], [65.42, 65.66, " what"], [65.66, 66.02, " Machu"], [66.02, 66.3, " Picchu"], [66.3, 66.6, " really"], [66.6, 66.84, " looks"], [66.84, 67.36, " like."]]}, {"start": 67.74, "end": 72.56, "text": "Stone terraces and houses on a ridge with the peak behind them often wrapped in cloud.", "words": [[67.74, 67.98, " Stone"], [67.98, 68.54, " terraces"], [68.54, 68.74, " and"], [68.74, 69.08, " houses"], [69.08, 69.34, " on"], [69.34, 69.48, " a"], [69.48, 69.76, " ridge"], [69.76, 70.16, " with"], [70.16, 70.34, " the"], [70.34, 70.52, " peak"], [70.52, 70.86, " behind"], [70.86, 71.22, " them"], [71.22, 71.7, " often"], [71.7, 72.0, " wrapped"], [72.0, 72.3, " in"], [72.3, 72.56, " cloud."]]}, {"start": 73.34, "end": 86.32, "text": "A photograph from Hiram Bingham's expedition in 1912 shows the same place as a field of", "words": [[73.34, 73.54, " A"], [73.54, 73.94, " photograph"], [73.94, 74.22, " from"], [74.22, 74.5, " Hiram"], [74.5, 75.18, " Bingham's"], [75.18, 75.7, " expedition"], [75.7, 76.0, " in"], [76.0, 77.06, " 1912"], [77.06, 77.48, " shows"], [77.48, 77.78, " the"], [77.78, 78.04, " same"], [78.04, 78.44, " place"], [78.44, 78.68, " as"], [78.68, 78.88, " a"], [78.88, 79.06, " field"], [79.06, 86.32, " of"]]}, {"start": 86.32, "end": 90.92, "text": "3,500 visitors a day and up to 5,600 in peak season.", "words": [[86.32, 86.34, " 3"], [86.34, 86.96, ",500"], [86.96, 87.48, " visitors"], [87.48, 87.72, " a"], [87.72, 88.16, " day"], [88.16, 88.5, " and"], [88.5, 88.68, " up"], [88.68, 88.96, " to"], [88.96, 89.18, " 5"], [89.18, 89.68, ",600"], [89.68, 90.06, " in"], [90.06, 90.26, " peak"], [90.26, 90.92, " season."]]}, {"start": 92.18, "end": 98.62, "text": "What you're looking at here specifically is the White Rim Trail in Canyonlands National Park.", "words": [[92.18, 92.36, " What"], [92.36, 92.56, " you're"], [92.56, 92.82, " looking"], [92.82, 93.1, " at"], [93.1, 93.44, " here"], [93.44, 94.2, " specifically"], [94.2, 94.7, " is"], [94.7, 95.02, " the"], [95.02, 95.38, " White"], [95.38, 95.62, " Rim"], [95.62, 96.2, " Trail"], [96.2, 96.82, " in"], [96.82, 97.46, " Canyonlands"], [97.46, 98.16, " National"], [98.16, 98.62, " Park."]]}, {"start": 102.03, "end": 106.15, "text": "The clip shows two cyclists on a dirt road with a red mesa behind them.", "words": [[102.03, 102.17, " The"], [102.17, 102.35, " clip"], [102.35, 102.65, 