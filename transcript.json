{"duration": 69.5666875, "segments": [{"start": 0.24, "end": 10.32, "text": "भारत की एक नेकेर स्पोर्ट बाइक, सिंगल सिलेंडर, लिक्विड कूलड इंजन, जिसकी क्षम्ता 199 दश्मलभ पांच सीसी है.", "words": [[0.24, 1.16, " भारत"], [1.16, 1.34, " की"], [1.34, 1.74, " एक"], [1.74, 2.26, " नेकेर"], [2.26, 2.68, " स्पोर्ट"], [2.68, 3.5, " बाइक,"], [3.58, 4.12, " सिंगल"], [4.12, 4.8, " सिलेंडर,"], [4.9, 5.4, " लिक्विड"], [5.4, 5.92, " कूलड"], [5.92, 6.24, " इंजन,"], [6.46, 6.84, " जिसकी"], [6.84, 7.48, " क्षम्ता"], [7.48, 8.38, " 199"], [8.38, 9.2, " दश्मलभ"], [9.2, 9.52, " पांच"], [9.52, 9.92, " सीसी"], [9.92, 10.32, " है."]]}, {"start": 11.8, "end": 17.02, "text": "प्रेस्थ स्टील का पेरिमेटर प्रेम, 17 इंच के अलोई वील और चार वाल्व.", "words": [[11.8, 12.2, " प्रेस्थ"], [12.2, 12.54, " स्टील"], [12.54, 12.76, " का"], [12.76, 13.48, " पेरिमेटर"], [13.48, 13.94, " प्रेम,"], [14.08, 14.44, " 17"], [14.44, 14.76, " इंच"], [14.76, 15.02, " के"], [15.02, 15.32, " अलोई"], [15.32, 15.72, " वील"], [15.72, 16.02, " और"], [16.02, 16.36, " चार"], [16.36, 17.02, " वाल्व."]]}, {"start": 17.02, "end": 25.12, "text": "मौजूदा वर्जन में फ्यूल इंजेक्षन है, इस बाइक में एबी एस है, फोर्क पर लगा लेबल यही बताता है.", "words": [[17.02, 17.96, " मौजूदा"], [17.96, 18.4, " वर्जन"], [18.4, 18.7, " में"], [18.7, 19.24, " फ्यूल"], [19.24, 19.76, " इंजेक्षन"], [19.76, 20.4, " है,"], [20.62, 20.9, " इस"], [20.9, 21.26, " बाइक"], [21.26, 21.5, " में"], [21.5, 21.94, " एबी"], [21.94, 22.14, " एस"], [22.14, 22.5, " है,"], [22.68, 23.04, " फोर्क"], [23.04, 23.22, " पर"], [23.22, 23.62, " लगा"], [23.62, 23.98, " लेबल"], [23.98, 24.3, " यही"], [24.3, 24.76, " बताता"], [24.76, 25.12, " है."]]}, {"start": 26.7, "end": 31.36, "text": "अर्जिन्टिना में यह राउजर एन एस 200 के नाम से बिकती है.", "words": [[26.7, 27.42, " अर्जिन्टिना"], [27.42, 27.92, " में"], [27.92, 28.08, " यह"], [28.08, 28.78, " राउजर"], [28.78, 29.04, " एन"], [29.04, 29.26, " एस"], [29.26, 29.64, " 200"], [29.64, 29.92, " के"], [29.92, 30.2, " नाम"], [30.2, 30.36, " से"], [30.36, 30.74, " बिकती"], [30.74, 31.36, " है."]]}, {"start": 31.36, "end": 37.72, "text": "इंजिन कवर पर DTSI का बैज है, और टैंक श्राउड पर बढ़ा सा 200 लिखा है.", "words": [[31.36, 31.98, " इंजिन"], [31.98, 32.24, " कवर"], [32.24, 32.5, " पर"], [32.5, 33.78, " DTSI"], [33.78, 33.96, " का"], [33.96, 34.18, " बैज"], [34.18, 34.56, " है,"], [34.62, 34.9, " और"], [34.9, 35.28, " टैंक"], [35.28, 35.7, " श्राउड"], [35.7, 35.98, " पर"], [35.98, 36.42, " बढ़ा"], [36.42, 36.62, " सा"], [36.62, 36.96, " 200"], [36.96, 37.34, " लिखा"], [37.34, 37.72, " है."]]}, {"start": 39.3, "end": 45.44, "text": "हर बाइक स्टोक नहीं रहती, इस बाइक का इग्सोस्ट बाद में लगा यह हुआ लगता है.", "words": [[39.3, 39.58, " हर"], [39.58, 39.96, " बाइक"], [39.96, 40.32, " स्टोक"], [40.32, 40.64, " नहीं"], [40.64, 41.16, " रहती,"], [41.76, 42.02, " इस"], [42.02, 42.48, " बाइक"], [42.48, 42.68, " का"], [42.68, 43.4, " इग्सोस्ट"], [43.4, 43.84, " बाद"], [43.84, 43.9, " में"], [43.9, 44.4, " लगा"], [44.4, 44.54, " यह"], [44.54, 44.68, " हुआ"], [44.68, 45.06, " लगता"], [45.06, 45.44, " है."]]}, {"start": 47.02, "end": 54.7, "text": "अक्टूबर 2020 मास्को, एक इन एस 200 जिस पर टॉप केस और कूरियर बैग लगा है.", "words": [[47.02, 47.64, " अक्टूबर"], [47.64, 48.32, " 2020"], [48.32, 49.84, " मास्को,"], [50.12, 50.38, " एक"], [50.38, 50.7, " इन"], [50.7, 50.88, " एस"], [50.88, 51.4, " 200"], [51.4, 51.94, " जिस"], [51.94, 52.06, " पर"], [52.06, 52.46, " टॉप"], [52.46, 52.9, " केस"], [52.9, 53.12, " और"], [53.12, 53.62, " कूरियर"], [53.62, 53.84, " बैग"], [53.84, 54.24, " लगा"], [54.24, 54.7, " है."]]}, {"start": 54.7, "end": 60.7, "text": "फोटोग्राफर का रूसी कैटशन कहता है, भारती जापानियों की जगह ले रही हैं.", "words": [[54.7, 55.92, " फोटोग्राफर"], [55.92, 56.3, " का"], [56.3, 56.72, " रूसी"], [56.72, 57.2, " कैटशन"], [57.2, 57.66, " कहता"], [57.66, 57.9, " है,"], [58.1, 58.66, " भारती"], [58.66, 59.38, " जापानियों"], [59.38, 59.54, " की"], [59.54, 59.92, " जगह"], [59.92, 60.12, " ले"], [60.12, 60.4, " रही"]