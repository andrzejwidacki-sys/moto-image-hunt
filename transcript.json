.89, 289.23, " 277"], [289.23, 289.45, " mil"], [289.45, 290.25, " długości."], [290.63, 290.77, " To"], [290.77, 292.03, " 446"], [292.03, 293.31, " kilometrów."], [293.47, 293.69, " Do"], [293.69, 294.35, " 18"], [294.35, 294.65, " mil"], [294.65, 295.51, " szerokości."], [295.91, 296.15, " I"], [296.15, 296.47, " ponad"], [296.47, 296.73, " mile"], [296.73, 297.77, " głębokości."]]}, {"start": 297.77, "end": 312.87, "text": "Teraz szlak Bright Angel. Cieszka to tylko ciemka linia zakosów na ścianie. A o zachodze słońca jeden turysta pokazuje skalę. Falne świątynie poniżej łapią ostatnie światło. Wyrok. Rzeczywistość jest większa.", "words": [[297.77, 298.45, " Teraz"], [298.45, 298.89, " szlak"], [298.89, 299.27, " Bright"], [299.27, 299.95, " Angel."], [300.19, 300.65, " Cieszka"], [300.65, 300.87, " to"], [300.87, 301.23, " tylko"], [301.23, 301.63, " ciemka"], [301.63, 301.89, " linia"], [301.89, 302.41, " zakosów"], [302.41, 302.59, " na"], [302.59, 303.07, " ścianie."], [303.55, 303.67, " A"], [303.67, 303.81, " o"], [303.81, 304.19, " zachodze"], [304.19, 304.63, " słońca"], [304.63, 304.89, " jeden"], [304.89, 305.39, " turysta"], [305.39, 305.93, " pokazuje"], [305.93, 306.79, " skalę."], [307.01, 307.33, " Falne"], [307.33, 307.87, " świątynie"], [307.87, 308.37, " poniżej"], [308.37, 308.79, " łapią"], [308.79, 309.29, " ostatnie"], [309.29, 310.09, " światło."], [310.35, 310.81, " Wyrok."], [311.03, 311.79, " Rzeczywistość"], [311.79, 312.09, " jest"], [312.09, 312.87, " większa."]]}, {"start": 314.49, "end": 330.61, "text": "Podsumujmy. Czy razy kadr wybierał, czy razy rzeczywistość była większa? Dwa razy kadr był uczciwy. Vlogi nie kłanią. Vlogi wykadrowują. Które miejsce zaskoczyło cię najbardziej? Napisz w komentarzu, które sprawdzić następne.", "words": [[314.49, 315.19, " Podsumujmy."], [315.37, 315.51, " Czy"], [315.51, 315.91, " razy"], [315.91, 316.11, " kadr"], [316.11, 316.85, " wybierał,"], [317.01, 317.15, " czy"], [317.15, 317.61, " razy"