{"duration": 69.568, "segments": [{"start": 0.24, "end": 10.52, "text": "भारत की एक नेकेर स्पूर्ट भाइक, सिंगल सिलेंडर, लिक्विड कूलड इंजन, जिसकी क्षमता एक सूर निन्यान्बे दश्मलव पांच सीसी है.", "words": [[0.24, 1.16, " भारत"], [1.16, 1.34, " की"], [1.34, 1.76, " एक"], [1.76, 2.3, " नेकेर"], [2.3, 2.68, " स्पूर्ट"], [2.68, 3.46, " भाइक,"], [3.64, 4.12, " सिंगल"], [4.12, 4.8, " सिलेंडर,"], [4.9, 5.36, " लिक्विड"], [5.36, 5.98, " कूलड"], [5.98, 6.22, " इंजन,"], [6.48, 6.86, " जिसकी"], [6.86, 7.44, " क्षमता"], [7.44, 7.72, " एक"], [7.72, 8.02, " सूर"], [8.02, 8.6, " निन्यान्बे"], [8.6, 9.22, " दश्मलव"], [9.22, 9.54, " पांच"], [9.54, 9.92, " सीसी"], [9.92, 10.52, " है."]]}, {"start": 11.6, "end": 20.08, "text": "प्रेस्ट स्टील का पेरिमेटर प्रेम, 17 इंच के अलोई भील और चार वाल, मौजूदा वर्जन में फ्यूल इंजेक्षन है.", "words": [[11.6, 12.32, " प्रेस्ट"], [12.32, 12.54, " स्टील"], [12.54, 12.76, " का"], [12.76, 13.46, " पेरिमेटर"], [13.46, 13.96, " प्रेम,"], [14.08, 14.46, " 17"], [14.46, 14.78, " इंच"], [14.78, 14.98, " के"], [14.98, 15.34, " अलोई"], [15.34, 15.78, " भील"], [15.78, 16.04, " और"], [16.04, 16.36, " चार"], [16.36, 17.14, " वाल,"], [17.36, 17.96, " मौजूदा"], [17.96, 18.36, " वर्जन"], [18.36, 18.74, " में"], [18.74, 19.24, " फ्यूल"], [19.24, 19.76, " इंजेक्षन"], [19.76, 20.08, " है."]]}, {"start": 20.64, "end": 26.08, "text": "इस भाइक में एबी एस है, फॉर्क पर लगा लेबल यही बताता है.", "words": [[20.64, 20.9, " इस"], [20.9, 21.26, " भाइक"], [21.26, 21.52, " में"], [21.52, 21.94, " एबी"], [21.94, 22.16, " एस"], [22.16, 22.5, " है,"], [22.66, 23.02, " फॉर्क"], [23.02, 23.22, " पर"], [23.22, 23.66, " लगा"], [23.66, 24.0, " लेबल"], [24.0, 24.28, " यही"], [24.28, 24.74, " बताता"], [24.74, 26.08, " है."]]}, {"start": 26.72, "end": 31.1, "text": "अर्जेन्टिना में यह राॉसर एन एस 200 के नाम से बिकती है.", "words": [[26.72, 27.44, " अर्जेन्टिना"], [27.44, 27.92, " में"], [27.92, 28.1, " यह"], [28.1, 28.78, " राॉसर"], [28.78, 29.08, " एन"], [29.08, 29.26, " एस"], [29.26, 29.68, " 2