{"duration": 61.8453125, "segments": [{"start": 0.3, "end": 2.46, "text": "A naked sport bike from India.", "words": [[0.3, 0.8, " A"], [0.8, 1.2, " naked"], [1.2, 1.5, " sport"], [1.5, 1.76, " bike"], [1.76, 1.94, " from"], [1.94, 2.46, " India."]]}, {"start": 3.16, "end": 9.8, "text": "A single cylinder, liquid-cooled engine with a displacement of 199.5 cubic centimeters.", "words": [[3.16, 3.26, " A"], [3.26, 3.6, " single"], [3.6, 4.12, " cylinder,"], [4.52, 4.78, " liquid"], [4.78, 5.12, "-cooled"], [5.12, 5.54, " engine"], [5.54, 5.98, " with"], [5.98, 6.22, " a"], [6.22, 6.66, " displacement"], [6.66, 7.02, " of"], [7.02, 7.84, " 199"], [7.84, 8.84, ".5"], [8.84, 9.22, " cubic"], [9.22, 9.8, " centimeters."]]}, {"start": 11.5, "end": 15.76, "text": "A pressed steel perimeter frame, 17-inch alloy wheels and four valves.", "words": [[11.5, 11.68, " A"], [11.68, 11.86, " pressed"], [11.86, 12.18, " steel"], [12.18, 12.58, " perimeter"], [12.58, 12.98, " frame,"], [13.5, 13.84, " 17"], [13.84, 14.1, "-inch"], [14.1, 14.44, " alloy"], [14.44, 14.8, " wheels"], [14.8, 15.02, " and"], [15.02, 15.28, " four"], [15.28, 15.76, " valves."]]}, {"start": 16.4, "end": 18.56, "text": "The current version is fuel-injected.", "words": [[16.4, 16.52, " The"], [16.52, 16.72, " current"], [16.72, 17.14, " version"], [17.14, 17.52, " is"], [17.52, 17.8, " fuel"], [17.8, 18.56, "-injected."]]}, {"start": 19.0, "end": 22.3, "text": "This one carries a BS, the label on the fork says so.", "words": [[19.0, 19.22, " This"], [19.22, 19.42, " one"], [19.42, 19.76, " carries"], [19.76, 19.96, " a"], [19.96, 20.3, " BS,"], [20.66, 20.86, " the"], [20.86, 21.08, " label"], [21.08, 21.26, " on"], [21.26, 21.42, " the"], [21.42, 21.58, " fork"], [21.58, 21.8, " says"], [21.8, 22.3, " so."]]}, {"start": 23.82, "end": 27.26, "text": "In Argentina, it is sold as the Rausser NS200.", "words": [[23.82, 24.06, " In"], [24.06, 24.56, " Argentina,"], [24.96, 25.04, " it"], [25.04, 25.28, " is"], [25.28, 25.5, " sold"], [25.5, 25.68, " as"], [25.68, 25.84, " the"], [25.84, 26.3, " Rausser"], [26.3, 27.26, " NS200."]]}, {"start": 27.7, "end": 32.7, "text": "The engine cover carries a DTSI badge and the tank shroud a big 200.", "words": [[27.7, 28.02, " The"], [28.02, 28.44, " engine"], [28.44, 28.72, " cover"], [28.72, 29.12, " carries"], [29.12, 29.44, " a"], [29.44, 30.24, " DTSI"], [30.24, 30.58, " badge"], [30.58, 31.12, " and"], [31.12, 31.32, " the"], [31.32, 31.5, " tank"], [31.5, 31.76, " shroud"], [31.76, 31.92, " a"], [31.92, 32.1, " big"], [32.1, 32.7, " 200."]]}, {"start": 34.48, "end": 35.84, "text": "Not everyone stays stock.", "words": [[34.48, 34.72, " Not"], [34.72, 35.14, " everyone"], [35.14, 35.46, " stays"], [35.46, 35.84, " stock."]]}, {"start": 36.62, "end": 38.94, "text": "The exhaust on this one looks aftermarket.", "words": [[36.62, 36.88, " The"], [36.88, 37.18, " exhaust"], [37.18, 37.36, " on"], [37.36, 37.62, " this"], [37.62, 37.82, " one"], [37.82, 38.08, " looks"], [38.08, 38.94, " aftermarket."]]}, {"start": 41.57, "end": 43.45, "text": "October 2026, Moscow.", "words": [[41.57, 41.83, " October"], [41.83, 42.75, " 2026,"], [42.99, 43.45, " Moscow."]]}, {"start": 44.19, "end": 47.11, "text": "An NS200 with a top case and a courier bag.", "words": [[44.19, 44.37, " An"], [44.37, 45.19, " NS200"], [45.19, 45.45, " with"], [45.45, 45.65, " a"], [45.65, 45.83, " top"], [45.83, 46.15, " case"], [46.15, 46.35, " and"], [46.35, 46.51, " a"], [46.51, 46.83, " courier"], [46.83, 47.11, " bag."]]}, {"start": 47.79, "end": 52.69, "text": "The photographer's Russian caption reads, Indians are coming to replace the Japanese.", "words": [[47.79, 47.99, " The"], [47.99, 48.67, " photographer's"], [48.67, 49.03, " Russian"], [49.03, 49.45, " caption"], [49.45, 49.93, " reads,"], [50.57, 50.93, " Indians"], [50.93, 51.23, " are"], [51.23, 51.43, " coming"], [51.43, 51.71, " to"], [51.71, 52.01, " replace"], [52.01, 52.27, " the"], [52.27, 52.69, " Japanese."]]}]}