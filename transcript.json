{"duration": 341.4666875, "segments": [{"start": 0.0, "end": 12.66, "text": "To jest Machu Picchu, rok 1912. Pole Gruzu, a to też jest Machu Picchu. To samo miejsce. Ponad 100 lat i jedna decyzja, co pokazać.", "words": [[0.0, 0.3, " To"], [0.3, 0.62, " jest"], [0.62, 1.08, " Machu"], [1.08, 1.78, " Picchu,"], [2.08, 2.26, " rok"], [2.26, 4.28, " 1912."], [4.6, 4.74, " Pole"], [4.74, 5.28, " Gruzu,"], [5.62, 5.76, " a"], [5.76, 5.92, " to"], [5.92, 6.2, " też"], [6.2, 6.5, " jest"], [6.5, 6.88, " Machu"], [6.88, 7.5, " Picchu."], [7.82, 7.94, " To"], [7.94, 8.22, " samo"], [8.22, 8.84, " miejsce."], [9.42, 9.74, " Ponad"], [9.74, 9.92, " 100"], [9.92, 10.14, " lat"], [10.14, 10.42, " i"], [10.42, 10.66, " jedna"], [10.66, 11.36, " decyzja,"], [11.46, 11.66, " co"], [11.66, 12.66, " pokazać."]]}, {"start": 13.06, "end": 17.48, "text": "W każdym vlogu zobaczysz tę wersję. I nikt cię nie okłamuje.", "words": [[13.06, 13.16, " W"], [13.16, 13.5, " każdym"], [13.5, 13.86, " vlogu"], [13.86, 14.26, " zobaczysz"], [14.26, 14.44, " tę"], [14.44, 15.32, " wersję."], [15.52, 15.72, " I"], [15.72, 16.08, " nikt"], [16.08, 16.22, " cię"], [16.22, 16.5, " nie"], [16.5, 17.48, " okłamuje."]]}, {"start": 18.02, "end": 28.68, "text": "Kadr nie kłamie. Kadr wybiera 8 miejsc z jednego vloga. Potem pokazuję, jak jest na prawdę. 7 sposobów, na jakie kadr zmienia świat.", "words": [[18.02, 18.24, " Kadr"], [18.24, 18.46, " nie"], [18.46, 19.1, " kłamie."], [19.26, 19.62, " Kadr"], [19.62, 20.3, " wybiera"], [20.3, 20.9, " 8"], [20.9, 21.4, " miejsc"], [21.4, 21.7, " z"], [21.7, 22.06, " jednego"], [22.06, 22.82, " vloga."], [23.0, 23.38, " Potem"], [23.38, 24.12, " pokazuję,"], [24.42, 24.52, " jak"], [24.52, 24.8, " jest"], [24.8, 25.04, " na"], [25.04, 25.76, " prawdę."], [25.86, 26.06, " 7"], [26.06, 26.9, " sposobów,"], [27.08, 27.26, " na"], [27.26, 27.48, " jakie"], [27.48, 27.86, " kadr"], [27.86, 28.2, " zmienia"], [28.2, 28.68, " świat."]]}, {"start": 28.68, "end": 40.68, "text": "Czach. Czas. Czale. Zasięg. Pora dnia. Webły. Wysokość. Pogoda. Każde miejsce dostaje z tempe. Zaczynamy od Machu Picchu.", "words": [[28.68, 28.86, " Czach."], [29.1, 29.86, " Czas."], [30.08, 30.44, " Czale."], [30.94, 31.7, " Zasięg."], [31.9, 32.12, " Pora"], [32.12, 32.68, " dnia."], [33.0, 33.5, " Webły."], [34.08, 34.88, " Wysokość."], [35.14, 35.72, " Pogoda."], [36.2, 36.44, " Każde"], [36.44, 36.86, " miejsce"], [36.86, 37.44, " dostaje"], [37.44, 37.66, " z"], [37.66, 38.0, " tempe."], [38.52, 39.12, " Zaczynamy"], [39.12, 39.32, " od"], [39.32, 39.74, " Machu"], [39.74, 40.68, " Picchu."]]}, {"start": 41.68, "end": 58.48, "text": "Tak wyglądało to miejsce w 1912 roku. Wyprawa Hirama Bingama została Pole Gruzu. Potem przyszła renowacja, od 1929 do 1971. Vlog pokazuje miejsce po remoncie.", "words": [[41.68, 42.3, " Tak"], [42.3, 43.02, " wyglądało"], [43.02, 43.2, " to"], [43.2, 43.46, " miejsce"], [43.46, 43.82, " w"], [43.82, 44.96, " 1912"], [44.96, 45.58, " roku."], [45.96, 46.46, " Wyprawa"], [46.46, 46.92, " Hirama"], [46.92, 47.36, " Bingama"], [47.36, 47.9, " została"], [47.9, 48.1, " Pole"], [48.1, 48.62, " Gruzu."], [48.98, 49.34, " Potem"], [49.34, 49.8, " przyszła"], [49.8, 50.62, " renowacja,"], [50.96, 51.22, " od"], [51.22, 52.74, " 1929"], [52.74, 53.54, " do"], [53.54, 55.14, " 1971."], [56.24, 56.52, " Vlog"], [56.52, 57.14, " pokazuje"], [57.14, 57.56, " miejsce"], [57.56, 57.82, " po"], [57.82, 58.48, " remoncie."]]}, {"start": 58.48, "end": 70.48, "text": "A dziś do Cytadeli wchodzi do 4500 osób dziennie. Cześć sezonu to 5600. Tu mu tu nie widać, a to też wybór. Wyrok. Kadr wybiera.", "words": [[58.48, 59.02, " A"], [59.02, 59.22, " dziś"], [59.22, 59.38, " do"], [59.38, 59.82, " Cytadeli"], [59.82, 60.14, " wchodzi"], [60.14, 60.46, " do"], [60.46, 61.84, " 4500"], [61.84, 62.22, " osób"], [62.22, 63.0, " dziennie."], [63.2, 63.34, " Cześć"], [63.34, 63.78, " sezonu"], [63.78, 63.92, " to"], [63.92, 65.28, " 5600."], [65.94, 66.06, " Tu"], [66.06, 66.22, " mu"], [66.22, 66.38, " tu"], [66.38, 66.58, " nie"], [66.58, 66.94, " widać,"], [67.16, 67.26, " a"], [67.26, 67.44, " to"], [67.44, 67.66, " też"], [67.66, 68.22, " wybór."], [68.62, 69.16, " Wyrok."], [69.38, 69.66, " Kadr"], [69.66, 70.48, " wybiera."]]}, {"start": 71.72, "end": 84.37, "text": "Piękny kadr. I ani jednego człowieka. A bez człowieka góra nie ma skali. Popatrz na Amadaban. Cześć tysięcy 812 metrów.", "words": [[71.72, 72.56, " Piękny"], [72.56, 73.18, " kadr."], [73.46, 73.68, " I"], [73.68, 73.96, " ani"], [73.96, 74.46, " jednego"], [74.46, 75.16, " człowieka."], [75.56, 75.72, " A"], [75.72, 75.98, " bez"], [75.98, 76.5, " człowieka"], [76.5, 76.78, " góra"], [76.78, 76.94, " nie"], [76.94, 77.18, " ma"], [77.18, 78.14, " skali."], [79.87, 80.27, " Popatrz"], [80.27, 80.41, " na"], [80.41, 81.11, " Amadaban."], [81.53, 81.95, " Cześć"], [81.95, 82.41, " tysięcy"], [82.41, 83.57, " 812"], [83.57, 84.37, " metrów."]]}, {"start": 84.37, "end": 102.57, "text": "Przez kilka dni dominuje na wschodnim niebie każdemu, kto idzie do bazy pod Everestem. A to jeziora Gokio w Parku Narodowym Sagarmata. Od 4700 do 5000 metrów nad morzem. Teraz znajdź na zboczu dwie malutkie postacie. To jest prawdziwa skala.", "words": [[84.37, 84.79, " Przez"], [84.79, 85.11, " kilka"], [85.11, 85.35, " dni"], [85.35, 85.89, " dominuje"], [85.89, 86.09, " na"], [86.09, 86.53, " wschodnim"], [86.53, 86.87, " niebie"], [86.87, 87.61, " każdemu,"], [87.69, 87.87, " kto"], [87.87, 88.09, " idzie"], [88.09, 88.33, " do"], [88.33, 88.57, " bazy"], [88.57, 88.79, " pod"], [88.79, 89.51, " Everestem."], [89.89, 89.97, " A"], [89.97, 90.11, " to"], [90.11, 90.51, " jeziora"], [90.51, 90.87, " Gokio"], [90.87, 90.99, " w"], [90.99, 91.47, " Parku"], [91.47, 92.01, " Narodowym"], [92.01, 92.91, " Sagarmata."], [93.29, 93.45, " Od"], [93.45, 95.01, " 4700"], [95.01, 95.19, " do"], [95.19, 95.85, " 5000"], [95.85, 96.59, " metrów"], [96.59, 96.81, " nad"], [96.81, 97.41, " morzem."], [97.71, 97.99, " Teraz"], [97.99, 98.49, " znajdź"], [98.49, 98.61, " na"], [98.61, 99.01, " zboczu"], [99.01, 99.29, " dwie"], [99.29, 99.83, " malutkie"], [99.83, 100.43, " postacie."], [100.93, 101.07, " To"], [101.07, 101.35, " jest"], [101.35, 101.87, " prawdziwa"], [101.87, 102.57, " skala."]]}, {"start": 102.57, "end": 132.58, "text": "Wyrok. Rzeczywistość jest większa. Dwóch rowerzystów i czerwona skała. Prawdziwy kadr. Tylko że to ułamek drogi. To droga White Rim w Parku Narodowym Kenyonance. 71 mil, czyli około 115 kilometrów. Cała bez asfaltu. Zbudowano ją w latach 50. pod mesą Island in the Sky. Po co, żeby poszukiwacze Uranu dojechali do Złóż.", "words": [[102.57, 103.37, " Wyrok."], [103.65, 104.33, " Rzeczywistość"], [104.33, 104.59, " jest"], [104.59, 105.73, " większa."], [107.17, 107.51, " Dwóch"], [107.51, 108.17, " rowerzystów"], [108.17, 108.35, " i"], [108.35, 108.87, " czerwona"], [108.87, 109.75, " skała."], [109.91, 110.41, " Prawdziwy"], [110.41, 111.05, " kadr."], [111.17, 111.57, " Tylko"], [111.57, 111.77, " że"], [111.77, 111.93, " to"], [111.93, 112.45, " ułamek"], [112.45, 112.87, " drogi."], [114.96, 115.14, " To"], [115.14, 115.56, " droga"], [115.56, 115.88, " White"], [115.88, 116.08, " Rim"], [116.08, 116.22, " w"], [116.22, 116.68, " Parku"], [116.68, 117.24, " Narodowym"], [117.24, 118.2, " Kenyonance."], [118.5, 119.18, " 71"], [119.18, 119.8, " mil,"], [119.94, 120.2, " czyli"], [120.2, 120.74, " około"], [120.74, 121.4, " 115"], [121.4, 122.54, " kilometrów."], [122.74, 123.02, " Cała"], [123.02, 123.24, " bez"], [123.24, 124.26, " asfaltu."], [124.5, 125.12, " Zbudowano"], [125.12, 125.34, " ją"], [125.34, 125.5, " w"], [125.5, 125.9, " latach"], [125.9, 126.52, " 50."], [127.04, 127.22, " pod"], [127.22, 127.7, " mesą"], [127.7, 128.18, " Island"], [128.18, 128.54, " in"], [128.54, 128.66, " the"], [128.66, 129.0, " Sky."], [129.34, 129.62, " Po"], [129.62, 129.9, " co,"], [130.1, 130.32, " żeby"], [130.32, 131.16, " poszukiwacze"], [131.16, 131.54, " Uranu"], [131.54, 132.02, " dojechali"], [132.02, 132.26, " do"], [132.26, 132.58, " Złóż."]]}, {"start": 132.58, "end": 148.36, "text": "A teraz zobacz ją z góry, znad rzeki Green River. Rzeka płynie wśród kanionów daleko w dole. Wyrok. Uczciwy kadr. Efektowna erupcja w dzień. Ale ten wulkan ma drugą twarz.", "words": [[132.58, 133.1, " A"], [133.1, 133.46, " teraz"], [133.46, 133.88, " zobacz"], [133.88, 134.06, " ją"], [134.06, 134.26, " z"], [134.26, 134.84, " góry,"], [135.0, 135.24, " znad"], [135.24, 135.58, " rzeki"], [135.58, 135.9, " Green"], [135.9, 136.52, " River."], [136.88, 137.24, " Rzeka"], [137.24, 137.56, " płynie"], [137.56, 137.92, " wśród"], [137.92, 138.42, " kanionów"], [138.42, 138.88, " daleko"], [138.88, 139.06, " w"], [139.06, 139.46, " dole."], [139.9, 140.28, " Wyrok."], [140.52, 140.92, " Uczciwy"], [140.92, 141.92, " kadr."], [143.62, 144.32, " Efektowna"], [144.32, 144.78, " erupcja"], [144.78, 145.02, " w"], [145.02, 145.24, " dzień."], [145.72, 145.9, " Ale"], [145.9, 146.16, " ten"], [146.16, 146.58, " wulkan"], [146.58, 146.86, " ma"], [146.86, 147.28, " drugą"], [147.28, 148.36, " twarz."]]}, {"start": 150.08, "end": 177.98, "text": "Pułego w Gwatemali jest niemal stale aktywny. Mały wypuch z krateru co 15 do 20 minut. W nocy krater żarzy się na czerwoną. Tak wygląda w listopadzie 2017 roku. Większe erupcje. Ponad 80 od 1999 roku. Jedna z nich 31 stycznia 2018. Dzień później satelita Lensat 8 sfotografował smugę popiołu.", "words": [[150.08, 150.72, " Pułego"], [150.72, 150.88, " w"], [150.88, 151.5, " Gwatemali"], [151.5, 151.84, " jest"], [151.84, 152.24, " niemal"], [152.24, 152.56, " stale"], [152.56, 153.46, " aktywny."], [153.64, 154.02, " Mały"], [154.02, 154.3, " wypuch"], [154.3, 154.52, " z"], [154.52, 154.96, " krateru"], [154.96, 155.14, " co"], [155.14, 155.72, " 15"], [155.72, 155.94, " do"], [155.94, 156.44, " 20"], [156.44, 156.96, " minut."], [157.4, 157.52, " W"], [157.52, 157.8, " nocy"], [157.8, 158.2, " krater"], [158.2, 158.54, " żarzy"], [158.54, 158.76, " się"], [158.76, 158.94, " na"], [158.94, 159.54, " czerwoną."], [159.9, 160.16, " Tak"], [160.16, 160.64, " wygląda"], [160.64, 160.84, " w"], [160.84, 161.52, " listopadzie"], [161.52, 162.66, " 2017"], [162.66, 163.34, " roku."], [163.66, 164.16, " Większe"], [164.16, 164.86, " erupcje."], [165.22, 165.5, " Ponad"], [165.5, 166.14, " 80"], [166.14, 166.42, " od"], [166.42, 167.88, " 1999"], [167.88, 169.2, " roku."], [169.62, 169.94, " Jedna"], [169.94, 170.08, " z"], [170.08, 170.28, " nich"], [170.28, 171.26, " 31"], [171.26, 172.26, " stycznia"], [172.26, 173.38, " 2018."], [174.08, 174.34, " Dzień"], [174.34, 174.72, " później"], [174.72, 175.3, " satelita"], [175.3, 175.78, " Lensat"], [175.78, 176.08, " 8"], [176.08, 176.92, " sfotografował"], [176.92, 177.42, " smugę"], [177.42, 177.98, " popiołu."]]}, {"start": 177.98, "end": 179.98, "text": "Wyrok. Kadr wybiera.", "words": [[177.98, 178.94, " Wyrok."], [179.1, 179.38, " Kadr"], [179.38, 179.98, " wybiera."]]}, {"start": 181.58, "end": 188.32, "text": "Punkt widokowy i jeden stok. Tak wygląda cały kanion miedziany? Nie, to jeden kawałek.", "words": [[181.58, 181.88, " Punkt"], [181.88, 182.48, " widokowy"], [182.48, 182.72, " i"], [182.72, 183.04, " jeden"], [183.04, 183.52, " stok."], [183.8, 184.06, " Tak"], [184.06, 184.56, " wygląda"], [184.56, 185.0, " cały"], [185.0, 185.32, " kanion"], [185.32, 185.92, " miedziany?"], [186.28, 186.56, " Nie,"], [186.66, 186.84, " to"], [186.84, 187.2, " jeden"], [187.2, 188.32, " kawałek."]]}, {"start": 189.34, "end": 210.32, "text": "Kanion miedziany to nie jeden kanion. To system sześciu kanionów. Wyżłobiło je sześć rzek. Razem 65 tysięcy kilometrów kwadratowych. To wsiera madrę zachodniej. Z góry wygląda to jak labirynt grzbietów i wąwozów. Ciągnie się aż po horyzont. Wyrok. Rzeczywistość jest większa.", "words": [[189.34, 190.1, " Kanion"], [190.1, 190.56, " miedziany"], [190.56, 190.74, " to"], [190.74, 190.92, " nie"], [190.92, 191.24, " jeden"], [191.24, 191.82, " kanion."], [192.1, 192.18, " To"], [192.18, 192.54, " system"], [192.54, 193.1, " sześciu"], [193.1, 193.86, " kanionów."], [194.18, 194.8, " Wyżłobiło"], [194.8, 195.06, " je"], [195.06, 195.4, " sześć"], [195.4, 195.96, " rzek."], [196.24, 196.56, " Razem"], [196.56, 197.32, " 65"], [197.32, 198.06, " tysięcy"], [198.06, 198.84, " kilometrów"], [198.84, 199.76, " kwadratowych."], [200.14, 200.28, " To"], [200.28, 200.6, " wsiera"], [200.6, 201.02, " madrę"], [201.02, 201.7, " zachodniej."], [202.04, 202.22, " Z"], [202.22, 202.54, " góry"], [202.54, 202.96, " wygląda"], [202.96, 203.16, " to"], [203.16, 203.42, " jak"], [203.42, 203.94, " labirynt"], [203.94, 204.5, " grzbietów"], [204.5, 204.68, " i"], [204.68, 205.4, " wąwozów."], [205.78, 206.22, " Ciągnie"], [206.22, 206.48, " się"], [206.48, 206.7, " aż"], [206.7, 206.88, " po"], [206.88, 207.54, " horyzont."], [208.0, 208.5, " Wyrok."], [208.7, 209.46, " Rzeczywistość"], [209.46, 209.76, " jest"], [209.76, 210.32, " większa."]]}, {"start": 211.7, "end": 218.32, "text": "Z drona to porządny układ ulic. Miasto jak narysowane linijką. A jak wygląda z ziemi?", "words": [[211.7, 212.34, " Z"], [212.34, 212.58, " drona"], [212.58, 212.8, " to"], [212.8, 213.32, " porządny"], [213.32, 213.72, " układ"], [213.72, 214.46, " ulic."], [214.74, 215.06, " Miasto"], [215.06, 215.32, " jak"], [215.32, 215.9, " narysowane"], [215.9, 216.66, " linijką."], [216.98, 217.18, " A"], [217.18, 217.38, " jak"], [217.38, 217.76, " wygląda"], [217.76, 218.02, " z"], [218.02, 218.32, " ziemi?"]]}, {"start": 219.5, "end": 241.37, "text": "To Black Rock City. 2019 rok 78 850 uczestników. Dziewięć dni do amerykańskiego święta pracy. Na pustyni Black Rock w Nevadze. Teraz zejdź na ziemię. Kurz wisi nad miastem. Miasto widać z siodełka roweru. Wyrok. Kadr wybiera.", "words": [[219.5, 220.36, " To"], [220.36, 220.7, " Black"], [220.7, 220.9, " Rock"], [220.9, 221.44, " City."], [222.08, 222.94, " 2019"], [222.94, 223.82, " rok"], [223.82, 224.84, " 78"], [224.84, 226.72, " 850"], [226.72, 227.74, " uczestników."], [228.18, 228.66, " Dziewięć"], [228.66, 228.98, " dni"], [228.98, 229.62, " do"], [229.62, 230.4, " amerykańskiego"], [230.4, 230.9, " święta"], [230.9, 231.32, " pracy."], [231.9, 232.02, " Na"], [232.02, 232.56, " pustyni"], [232.56, 232.82, " Black"], [232.82, 233.06, " Rock"], [233.06, 233.22, " w"], [233.22, 233.88, " Nevadze."], [234.28, 234.52, " Teraz"], [234.52, 234.9, " zejdź"], [234.9, 235.14, " na"], [235.14, 235.78, " ziemię."], [235.92, 236.16, " Kurz"], [236.16, 236.38, " wisi"], [236.38, 236.64, " nad"], [236.64, 237.44, " miastem."], [237.7, 237.98, " Miasto"], [237.98, 238.3, " widać"], [238.3, 238.52, " z"], [238.52, 238.96, " siodełka"], [238.96, 239.68, " roweru."], [239.94, 240.4, " Wyrok."], [240.62, 240.94, " Kadr"], [240.94, 241.37, " wybiera."]]}, {"start": 243.01, "end": 263.05, "text": "Liście. Potem dwa wulkany. Chmury nad szczytem. Tu pogoda robi połowę roboty. Ometepe to jedna wyspa z dwóch wulkanów. Concepcion i Maderas łączy niski przesmyk. Wyspa ma 31 kilometrów długości. I od 5 do 10 kilometrów szerokości.", "words": [[243.01, 243.77, " Liście."], [244.03, 244.43, " Potem"], [244.43, 244.71, " dwa"], [244.71, 245.55, " wulkany."], [245.73, 246.07, " Chmury"], [246.07, 246.29, " nad"], [246.29, 246.87, " szczytem."], [247.29, 247.53, " Tu"], [247.53, 247.87, " pogoda"], [247.87, 248.17, " robi"], [248.17, 248.69, " połowę"], [248.69, 249.31, " roboty."], [251.33, 251.83, " Ometepe"], [251.83, 252.05, " to"], [252.05, 252.35, " jedna"], [252.35, 252.67, " wyspa"], [252.67, 252.89, " z"], [252.89, 253.17, " dwóch"], [253.17, 254.01, " wulkanów."], [254.39, 254.89, " Concepcion"], [254.89, 255.17, " i"], [255.17, 255.55, " Maderas"], [255.55, 255.95, " łączy"], [255.95, 256.35, " niski"], [256.35, 257.21, " przesmyk."], [257.39, 257.73, " Wyspa"], [25