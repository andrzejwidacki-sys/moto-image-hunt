ame"], [219.97, 220.49, " chooses."]]}, {"start": 222.05, "end": 226.31, "text": "Leaves then two volcanoes across the lake. Clouds sit over the summit.", "words": [[222.05, 222.65, " Leaves"], [222.65, 222.93, " then"], [222.93, 223.21, " two"], [223.21, 223.65, " volcanoes"], [223.65, 224.07, " across"], [224.07, 224.29, " the"], [224.29, 224.77, " lake."], [224.95, 225.51, " Clouds"], [225.51, 225.61, " sit"], [225.61, 225.83, " over"], [225.83, 226.03, " the"], [226.03, 226.31, " summit."]]}, {"start": 226.89, "end": 233.16, "text": "Here the weather does half the work. Ometepe is one island made of two volcanoes.", "words": [[226.89, 227.03, " Here"], [227.03, 227.21, " the"], [227.21, 227.41, " weather"], [227.41, 227.67, " does"], [227.67, 227.91, " half"], [227.91, 228.09, " the"], [228.09, 228.45, " work."], [230.54, 231.02, " Ometepe"], [231.02, 231.32, " is"], [231.32, 231.6, " one"], [231.6, 231.92, " island"], [231.92, 232.18, " made"], [232.18, 232.34, " of"], [232.34, 232.56, " two"], [232.56, 233.16, " volcanoes."]]}, {"start": 233.76, "end": 239.3, "text": "Concepcion and Maderas are joined by a low isthmus. The island is 31 kilometers long.", "words": [[233.76, 234.26, " Concepcion"], [234.26, 234.46, " and"], [234.46, 234.94, " Maderas"], [234.94, 235.38, " are"], [235.38, 235.62, " joined"], [235.62, 235.82, " by"], [235.82, 236.0, " a"], [236.0, 236.18, " low"], [236.18, 236.68, " isthmus."], [237.06, 237.22, " The"], [237.22, 237.56, " island"], [237.56, 237.92, " is"], [237.92, 238.3, " 31"], [238.3, 238.84, " kilometers"], [238.84, 239.3, " long."]]}, {"start": 239.68, "end": 244.52, "text": "And 5 to 10 kilometers wide. Concepcion is active with a textbook cone.", "words": [[239.68, 239.94, " And"], [239.94, 240.14, " 5"], [240.14, 240.3, " to"], [240.3, 240.6, " 10"], [240.6, 241.06, " kilometers"], [241.06, 241.46, " wide."], [242.06, 242.6, " Concepcion"], [242.6, 242.86, " is"], [242.86, 243.32, " active"], [243.32, 243.62, " with"], [24